  /// instantiation because Pass classes should only be visible by the current
  /// library.
  MLIR_DEFINE_EXPLICIT_INTERNAL_INLINE_TYPE_ID(TestApplyLoweringOptionBase<DerivedT>)

  TestApplyLoweringOptionBase(TestApplyLoweringOptionOptions options) : TestApplyLoweringOptionBase() {
    optionsString = std::move(options.optionsString);
  }
