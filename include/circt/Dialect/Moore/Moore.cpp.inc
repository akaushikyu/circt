    return ::mlir::failure();
  }
  if (fieldWidthAttr) result.getOrAddProperties<FormatRealOp::Properties>().fieldWidth = fieldWidthAttr;
  }
  if (::mlir::succeeded(parser.parseOptionalKeyword("fracDigits"))) {

