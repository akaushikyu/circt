::llvm::LogicalResult ClassPropertyRefOpAdaptor::verify(::mlir::Location loc) {
  auto tblgen_property = getProperties().property; (void)tblgen_property;
  if (!tblgen_property) return emitError(loc, "'moore.class.property_ref' op requires attribute 'property'");

  if (tblgen_property && !((::llvm::isa<::mlir::FlatSymbolRefAttr>(tblgen_property))))
    return emitError(loc, "'moore.class.property_ref' op attribute 'property' failed to satisfy constraint: flat symbol reference attribute");
  return ::mlir::success();
