void FormatStringOp::print(::mlir::OpAsmPrinter &_odsPrinter) {
  _odsPrinter << ' ';
  _odsPrinter << getString();
  if (getWidthAttr()) {
    _odsPrinter << ",";
    _odsPrinter << ' ' << "width";
    _odsPrinter << ' ';
    _odsPrinter.printAttributeWithoutType(getWidthAttr());
  }
  if (getAlignmentAttr()) {
    _odsPrinter << ",";
    _odsPrinter << ' ' << "alignment";
    _odsPrinter << ' ';

    {
      auto caseValue = *getAlignment();
      auto caseValueStr = stringifyIntAlign(caseValue);
      _odsPrinter << caseValueStr;
    }
  }
  if (getPaddingAttr()) {
    _odsPrinter << ",";
    _odsPrinter << ' ' << "padding";
    _odsPrinter << ' ';

    {
      auto caseValue = *getPadding();
      auto caseValueStr = stringifyIntPadding(caseValue);
      _odsPrinter << caseValueStr;
    }
  }
  ::llvm::SmallVector<::llvm::StringRef, 2> elidedAttrs;
  elidedAttrs.push_back("width");
  elidedAttrs.push_back("alignment");
  elidedAttrs.push_back("padding");
  _odsPrinter.printOptionalAttrDict((*this)->getAttrs(), elidedAttrs);
}

