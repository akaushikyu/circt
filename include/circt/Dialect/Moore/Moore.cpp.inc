void FormatRealOp::print(::mlir::OpAsmPrinter &_odsPrinter) {
  _odsPrinter << ' ';

  {
    auto caseValue = getFormat();
    auto caseValueStr = stringifyRealFormat(caseValue);
    _odsPrinter << caseValueStr;
  }
  _odsPrinter << ' ';
  _odsPrinter << getValue();
  _odsPrinter << ",";
  _odsPrinter << ' ' << "align";
  _odsPrinter << ' ';

  {
    auto caseValue = getAlignment();
    auto caseValueStr = stringifyIntAlign(caseValue);
    _odsPrinter << caseValueStr;
  }
  if (getFieldWidthAttr()) {
    _odsPrinter << ' ' << "fieldWidth";
    _odsPrinter << ' ';
    _odsPrinter.printAttributeWithoutType(getFieldWidthAttr());
  }
  if (getFracDigitsAttr()) {
    _odsPrinter << ' ' << "fracDigits";
    _odsPrinter << ' ';
    _odsPrinter.printAttributeWithoutType(getFracDigitsAttr());
  }
  ::llvm::SmallVector<::llvm::StringRef, 2> elidedAttrs;
  elidedAttrs.push_back("format");
  elidedAttrs.push_back("alignment");
  elidedAttrs.push_back("fieldWidth");
  elidedAttrs.push_back("fracDigits");
  _odsPrinter.printOptionalAttrDict((*this)->getAttrs(), elidedAttrs);
  _odsPrinter << ' ' << ":";
  _odsPrinter << ' ';
  {
    auto type = getValue().getType();
    if (auto validType = ::llvm::dyn_cast<::circt::moore::RealType>(type))
      _odsPrinter.printStrippedAttrOrType(validType);
   else
     _odsPrinter << type;
  }
}

