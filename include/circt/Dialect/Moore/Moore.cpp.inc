  auto tblgen_dpi_arg_dirs = getProperties().dpi_arg_dirs; (void)tblgen_dpi_arg_dirs;
  if (!tblgen_dpi_arg_dirs) return emitError(loc, "'moore.func.dpi' op requires attribute 'dpi_arg_dirs'");
  auto tblgen_dpi_arg_names = getProperties().dpi_arg_names; (void)tblgen_dpi_arg_names;
  if (!tblgen_dpi_arg_names) return emitError(loc, "'moore.func.dpi' op requires attribute 'dpi_arg_names'");
  auto tblgen_function_type = getProperties().function_type; (void)tblgen_function_type;
  if (!tblgen_function_type) return emitError(loc, "'moore.func.dpi' op requires attribute 'function_type'");
  auto tblgen_sym_name = getProperties().sym_name; (void)tblgen_sym_name;
  if (!tblgen_sym_name) return emitError(loc, "'moore.func.dpi' op requires attribute 'sym_name'");
  auto tblgen_sym_visibility = getProperties().sym_visibility; (void)tblgen_sym_visibility;
  auto tblgen_verilogName = getProperties().verilogName; (void)tblgen_verilogName;

  if (tblgen_sym_name && !((::llvm::isa<::mlir::StringAttr>(tblgen_sym_name))))
    return emitError(loc, "'moore.func.dpi' op attribute 'sym_name' failed to satisfy constraint: string attribute");

  if (tblgen_function_type && !(((::llvm::isa<::mlir::TypeAttr>(tblgen_function_type))) && ((::llvm::isa<::mlir::FunctionType>(::llvm::cast<::mlir::TypeAttr>(tblgen_function_type).getValue()))) && ((::llvm::isa<::mlir::FunctionType>(::llvm::cast<::mlir::TypeAttr>(tblgen_function_type).getValue())))))
    return emitError(loc, "'moore.func.dpi' op attribute 'function_type' failed to satisfy constraint: type attribute of function type");

  if (tblgen_dpi_arg_dirs && !((::llvm::isa<::mlir::ArrayAttr>(tblgen_dpi_arg_dirs))))
    return emitError(loc, "'moore.func.dpi' op attribute 'dpi_arg_dirs' failed to satisfy constraint: array attribute");

  if (tblgen_dpi_arg_names && !((::llvm::isa<::mlir::ArrayAttr>(tblgen_dpi_arg_names))))
    return emitError(loc, "'moore.func.dpi' op attribute 'dpi_arg_names' failed to satisfy constraint: array attribute");

  if (tblgen_argument_locs && !(((::llvm::isa<::mlir::ArrayAttr>(tblgen_argument_locs))) && (::llvm::all_of(::llvm::cast<::mlir::ArrayAttr>(tblgen_argument_locs), [&](::mlir::Attribute attr) { return attr && ((::llvm::isa<::mlir::LocationAttr>(attr))); }))))
    return emitError(loc, "'moore.func.dpi' op attribute 'argument_locs' failed to satisfy constraint: location array attribute");

  if (tblgen_verilogName && !((::llvm::isa<::mlir::StringAttr>(tblgen_verilogName))))
    return emitError(loc, "'moore.func.dpi' op attribute 'verilogName' failed to satisfy constraint: string attribute");

  if (tblgen_sym_visibility && !((::llvm::isa<::mlir::StringAttr>(tblgen_sym_visibility))))
    return emitError(loc, "'moore.func.dpi' op attribute 'sym_visibility' failed to satisfy constraint: string attribute");
  return ::mlir::success();
}

