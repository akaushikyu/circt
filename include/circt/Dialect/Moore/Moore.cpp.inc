void FormatIntOp::print(::mlir::OpAsmPrinter &_odsPrinter) {
  _odsPrinter << ' ';

  {
    auto caseValue = getFormat();
    auto caseValueStr = stringifyIntFormat(caseValue);
    _odsPrinter << caseValueStr;
  }
  _odsPrinter << ' ';
  _odsPrinter << getValue();
  _odsPrinter << ",";
  _odsPrinter << ' ' << "align";
  _odsPrinter << ' ';

  {
    auto caseValue = getAlignment();
    auto caseValueStr = stringifyIntAlign(caseValue);
    _odsPrinter << caseValueStr;
  }
  _odsPrinter << ",";
  _odsPrinter << ' ' << "pad";
  _odsPrinter << ' ';

  {
    auto caseValue = getPadding();
    auto caseValueStr = stringifyIntPadding(caseValue);
    _odsPrinter << caseValueStr;
  }
  if (getSpecifierWidthAttr()) {
    _odsPrinter << ' ' << "width";
    _odsPrinter << ' ';
    _odsPrinter.printAttributeWithoutType(getSpecifierWidthAttr());
  }
  if ((getIsSignedAttr() && getIsSignedAttr() != ((false) ? ::mlir::OpBuilder((*this)->getContext()).getUnitAttr() : nullptr))) {
    _odsPrinter << ' ' << "signed";
  }
  ::llvm::SmallVector<::llvm::StringRef, 2> elidedAttrs;
  elidedAttrs.push_back("format");
  elidedAttrs.push_back("alignment");
  elidedAttrs.push_back("padding");
  elidedAttrs.push_back("specifierWidth");
  elidedAttrs.push_back("isSigned");
  {
     ::mlir::Builder odsBuilder(getContext());
     ::mlir::Attribute attr = getIsSignedAttr();
     if(attr && (attr == ((false) ? odsBuilder.getUnitAttr() : nullptr)))
       elidedAttrs.push_back("isSigned");
  }
  _odsPrinter.printOptionalAttrDict((*this)->getAttrs(), elidedAttrs);
  _odsPrinter << ' ' << ":";
  _odsPrinter << ' ';
