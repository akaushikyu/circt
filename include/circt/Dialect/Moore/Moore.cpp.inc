}

void FormatRealOp::populateInherentAttrs(::mlir::MLIRContext *ctx, const Properties &prop, ::mlir::NamedAttrList &attrs) {
    if (prop.alignment) attrs.append("alignment", prop.alignment);

    if (prop.fieldWidth) attrs.append("fieldWidth", prop.fieldWidth);

    if (prop.format) attrs.append("format", prop.format);

    if (prop.fracDigits) attrs.append("fracDigits", prop.fracDigits);
}

::llvm::LogicalResult FormatRealOp::verifyInherentAttrs(::mlir::OperationName opName, ::mlir::NamedAttrList &attrs, llvm::function_ref<::mlir::InFlightDiagnostic()> emitError) {
    {
      ::mlir::Attribute attr = attrs.get(getAlignmentAttrName(opName));
      if (attr && ::mlir::failed(__mlir_ods_local_attr_constraint_Moore22(attr, "alignment", emitError)))
        return ::mlir::failure();
    }

    {
      ::mlir::Attribute attr = attrs.get(getFieldWidthAttrName(opName));
      if (attr && ::mlir::failed(__mlir_ods_local_attr_constraint_Moore15(attr, "fieldWidth", emitError)))
        return ::mlir::failure();
    }

    {
      ::mlir::Attribute attr = attrs.get(getFormatAttrName(opName));
      if (attr && ::mlir::failed(__mlir_ods_local_attr_constraint_Moore24(attr, "format", emitError)))
        return ::mlir::failure();
    }

    {
      ::mlir::Attribute attr = attrs.get(getFracDigitsAttrName(opName));
      if (attr && ::mlir::failed(__mlir_ods_local_attr_constraint_Moore15(attr, "fracDigits", emitError)))
        return ::mlir::failure();
    }
    return ::mlir::success();
}

::llvm::LogicalResult FormatRealOp::readProperties(::mlir::DialectBytecodeReader &reader, ::mlir::OperationState &state) {
  auto &prop = state.getOrAddProperties<Properties>(); (void)prop;
  if (::mlir::failed(reader.readAttribute(prop.alignment)))
    return ::mlir::failure();

  if (::mlir::failed(reader.readOptionalAttribute(prop.fieldWidth)))
    return ::mlir::failure();

  if (::mlir::failed(reader.readAttribute(prop.format)))
    return ::mlir::failure();

  if (::mlir::failed(reader.readOptionalAttribute(prop.fracDigits)))
    return ::mlir::failure();
  return ::mlir::success();
}

void FormatRealOp::writeProperties(::mlir::DialectBytecodeWriter &writer) {
  auto &prop = getProperties(); (void)prop;
  writer.writeAttribute(prop.alignment);

  writer.writeOptionalAttribute(prop.fieldWidth);
  writer.writeAttribute(prop.format);

  writer.writeOptionalAttribute(prop.fracDigits);
}

