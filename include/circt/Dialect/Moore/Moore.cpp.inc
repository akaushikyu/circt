::llvm::LogicalResult ClassDeclOp::verifyInvariantsImpl() {
  auto tblgen_base = getProperties().base; (void)tblgen_base;
  auto tblgen_implementedInterfaces = getProperties().implementedInterfaces; (void)tblgen_implementedInterfaces;
  auto tblgen_sym_name = getProperties().sym_name; (void)tblgen_sym_name;
  if (!tblgen_sym_name) return emitOpError("requires attribute 'sym_name'");

  if (::mlir::failed(__mlir_ods_local_attr_constraint_Moore2(*this, tblgen_sym_name, "sym_name")))
    return ::mlir::failure();

  if (::mlir::failed(__mlir_ods_local_attr_constraint_Moore4(*this, tblgen_base, "base")))
    return ::mlir::failure();

  if (::mlir::failed(__mlir_ods_local_attr_constraint_Moore5(*this, tblgen_implementedInterfaces, "implementedInterfaces")))
    return ::mlir::failure();
  {
    unsigned index = 0; (void)index;

    for (auto &region : ::llvm::MutableArrayRef((*this)->getRegion(0)))
      if (::mlir::failed(__mlir_ods_local_region_constraint_Moore1(*this, region, "body", index++)))
        return ::mlir::failure();
  }
  return ::mlir::success();
}

::llvm::LogicalResult ClassDeclOp::verifyInvariants() {
  if(::mlir::succeeded(verifyInvariantsImpl()) && ::mlir::succeeded(verify()))
    return ::mlir::success();
  return ::mlir::failure();
}

::mlir::ParseResult ClassDeclOp::parse(::mlir::OpAsmParser &parser, ::mlir::OperationState &result) {
  ::mlir::StringAttr sym_nameAttr;
  ::mlir::SymbolRefAttr baseAttr;
  ::mlir::ArrayAttr implementedInterfacesAttr;
  std::unique_ptr<::mlir::Region> bodyRegion = std::make_unique<::mlir::Region>();

  if (parser.parseSymbolName(sym_nameAttr))
    return ::mlir::failure();
  if (sym_nameAttr) result.getOrAddProperties<ClassDeclOp::Properties>().sym_name = sym_nameAttr;
  if (::mlir::succeeded(parser.parseOptionalKeyword("extends"))) {

  if (parser.parseCustomAttributeWithFallback(baseAttr, parser.getBuilder().getType<::mlir::NoneType>())) {
    return ::mlir::failure();
  }
  if (baseAttr) result.getOrAddProperties<ClassDeclOp::Properties>().base = baseAttr;
  }
  if (::mlir::succeeded(parser.parseOptionalKeyword("implements"))) {

  if (parser.parseCustomAttributeWithFallback(implementedInterfacesAttr, parser.getBuilder().getType<::mlir::NoneType>())) {
    return ::mlir::failure();
  }
  if (implementedInterfacesAttr) result.getOrAddProperties<ClassDeclOp::Properties>().implementedInterfaces = implementedInterfacesAttr;
  }
  {
    auto loc = parser.getCurrentLocation();(void)loc;
    if (parser.parseOptionalAttrDictWithKeyword(result.attributes))
      return ::mlir::failure();
    if (failed(verifyInherentAttrs(result.name, result.attributes, [&]() {
        return parser.emitError(loc) << "'" << result.name.getStringRef() << "' op ";
      })))
      return ::mlir::failure();
  }

  if (parser.parseRegion(*bodyRegion))
    return ::mlir::failure();

  if (bodyRegion->empty()) bodyRegion->emplaceBlock();
  result.addRegion(std::move(bodyRegion));
  return ::mlir::success();
}

void ClassDeclOp::print(::mlir::OpAsmPrinter &_odsPrinter) {
  _odsPrinter << ' ';
  _odsPrinter.printSymbolName(getSymNameAttr().getValue());
  if (getBaseAttr()) {
    _odsPrinter << ' ' << "extends";
    _odsPrinter << ' ';
    _odsPrinter.printAttributeWithoutType(getBaseAttr());
  }
  if (getImplementedInterfacesAttr()) {
    _odsPrinter << ' ' << "implements";
    _odsPrinter << ' ';
    _odsPrinter.printAttributeWithoutType(getImplementedInterfacesAttr());
  }
  ::llvm::SmallVector<::llvm::StringRef, 2> elidedAttrs;
  elidedAttrs.push_back("sym_name");
  elidedAttrs.push_back("base");
  elidedAttrs.push_back("implementedInterfaces");
  _odsPrinter.printOptionalAttrDictWithKeyword((*this)->getAttrs(), elidedAttrs);
  _odsPrinter << ' ';
  _odsPrinter.printRegion(getBody());
}


