/// left- and right-hand side operand. Corresponds to the `^` operator.
/// 
/// See IEEE 1800-2017 § 11.4.8 "Bitwise operators".
/// 
/// |   | 0 | 1 | X | Z |
/// |---|---|---|---|---|
/// | 0 | 0 | 1 | X | X |
/// | 1 | 1 | 0 | X | X |
/// | X | X | X | X | X |
/// | Z | X | X | X | X |
class XorOp;

} // namespace circt::moore
