::llvm::LogicalResult QueuePopFrontOp::verifyInvariantsImpl() {
  {
    unsigned index = 0; (void)index;
    auto valueGroup0 = getODSOperands(0);

    for (auto v : valueGroup0) {
      if (::mlir::failed(__mlir_ods_local_type_constraint_Sim11(*this, v.getType(), "operand", index++)))
        return ::mlir::failure();
    }
  }
  {
    unsigned index = 0; (void)index;
    auto valueGroup0 = getODSResults(0);

    for (auto v : valueGroup0) {
      if (::mlir::failed(__mlir_ods_local_type_constraint_Sim11(*this, v.getType(), "result", index++)))
        return ::mlir::failure();
    }
    auto valueGroup1 = getODSResults(1);

    for (auto v : valueGroup1) {
      if (::mlir::failed(__mlir_ods_local_type_constraint_Sim15(*this, v.getType(), "result", index++)))
        return ::mlir::failure();
    }
  }
  if (!((std::equal_to<>()(cast<QueueType>((*this->getODSOperands(0).begin()).getType()).getElementType(), (*this->getODSResults(1).begin()).getType()))))
    return emitOpError("failed to verify that queue and popped types must match");
  if (!((((*this->getODSOperands(0).begin()).getType()) == ((*this->getODSResults(0).begin()).getType()) && ((*this->getODSResults(0).begin()).getType()) == ((*this->getODSOperands(0).begin()).getType()))))
    return emitOpError("failed to verify that all of {queue, outQueue} have same type");
  return ::mlir::success();
}

::llvm::LogicalResult QueuePopFrontOp::verifyInvariants() {
  return verifyInvariantsImpl();
}

::llvm::LogicalResult QueuePopFrontOp::inferReturnTypes(::mlir::MLIRContext *context, ::std::optional<::mlir::Location> location, ::mlir::ValueRange operands, ::mlir::DictionaryAttr attributes, ::mlir::PropertyRef properties, ::mlir::RegionRange regions, ::llvm::SmallVectorImpl<::mlir::Type>&inferredReturnTypes) {
  inferredReturnTypes.resize(2);
  ::mlir::Builder odsBuilder(context);
  if (operands.size() <= 0)
    return ::mlir::failure();
  ::mlir::Type odsInferredType0 = operands[0].getType();
  ::mlir::Type odsInferredType1 = cast<QueueType>(operands[0].getType()).getElementType();
  inferredReturnTypes[0] = odsInferredType0;
  inferredReturnTypes[1] = odsInferredType1;
  return ::mlir::success();
}

::mlir::ParseResult QueuePopFrontOp::parse(::mlir::OpAsmParser &parser, ::mlir::OperationState &result) {
  ::mlir::OpAsmParser::UnresolvedOperand queueRawOperand{};
  ::llvm::ArrayRef<::mlir::OpAsmParser::UnresolvedOperand> queueOperands(&queueRawOperand, 1);  ::llvm::SMLoc queueOperandsLoc;
  (void)queueOperandsLoc;
  ::mlir::Type queueRawType{};
  ::llvm::ArrayRef<::mlir::Type> queueTypes(&queueRawType, 1);
  if (parser.parseKeyword("from"))
    return ::mlir::failure();

  queueOperandsLoc = parser.getCurrentLocation();
  if (parser.parseOperand(queueRawOperand))
    return ::mlir::failure();
  {
    auto loc = parser.getCurrentLocation();(void)loc;
    if (parser.parseOptionalAttrDict(result.attributes))
      return ::mlir::failure();
    if (failed(verifyInherentAttrs(result.name, result.attributes, [&]() {
        return parser.emitError(loc) << "'" << result.name.getStringRef() << "' op ";
      })))
      return ::mlir::failure();
  }
  if (parser.parseColon())
    return ::mlir::failure();

  {
    ::circt::sim::QueueType type;
    if (parser.parseCustomTypeWithFallback(type))
      return ::mlir::failure();
    queueRawType = type;
  }
  for (::mlir::Type type : queueTypes) {
    (void)type;
    if (!((::llvm::isa<::circt::sim::QueueType>(type)))) {
      return parser.emitError(parser.getNameLoc()) << "'queue' must be a queue type, but got " << type;
    }
  }
  result.addTypes(queueTypes[0]);
  result.addTypes(cast<QueueType>(queueTypes[0]).getElementType());
  if (parser.resolveOperands(queueOperands, queueTypes, queueOperandsLoc, result.operands))
    return ::mlir::failure();
  return ::mlir::success();
}

void QueuePopFrontOp::print(::mlir::OpAsmPrinter &_odsPrinter) {
  _odsPrinter << ' ' << "from";
  _odsPrinter << ' ';
  _odsPrinter << getQueue();
  ::llvm::SmallVector<::llvm::StringRef, 2> elidedAttrs;
  _odsPrinter.printOptionalAttrDict((*this)->getAttrs(), elidedAttrs);
  _odsPrinter << ' ' << ":";
  _odsPrinter << ' ';
  {
    auto type = getQueue().getType();
    if (auto validType = ::llvm::dyn_cast<::circt::sim::QueueType>(type))
      _odsPrinter.printStrippedAttrOrType(validType);
   else
     _odsPrinter << type;
  }
}

