::llvm::LogicalResult TerminateOp::verifyInvariantsImpl() {
  auto tblgen_success = getProperties().success; (void)tblgen_success;
  if (!tblgen_success) return emitOpError("requires attribute 'success'");
  auto tblgen_verbose = getProperties().verbose; (void)tblgen_verbose;
  if (!tblgen_verbose) return emitOpError("requires attribute 'verbose'");

  if (::mlir::failed(__mlir_ods_local_attr_constraint_Sim1(*this, tblgen_success, "success")))
    return ::mlir::failure();

  if (::mlir::failed(__mlir_ods_local_attr_constraint_Sim1(*this, tblgen_verbose, "verbose")))
    return ::mlir::failure();
  return ::mlir::success();
}

::llvm::LogicalResult TerminateOp::verifyInvariants() {
  return verifyInvariantsImpl();
}

::mlir::ParseResult TerminateOp::parse(::mlir::OpAsmParser &parser, ::mlir::OperationState &result) {
  ::mlir::BoolAttr successAttr;
  ::mlir::BoolAttr verboseAttr;
  {
    auto odsResult = parseKeywordBool(parser, successAttr, "success", "failure");
    if (odsResult) return ::mlir::failure();
    result.getOrAddProperties<TerminateOp::Properties>().success = successAttr;
  }
  if (parser.parseComma())
    return ::mlir::failure();
  {
    auto odsResult = parseKeywordBool(parser, verboseAttr, "verbose", "quiet");
    if (odsResult) return ::mlir::failure();
    result.getOrAddProperties<TerminateOp::Properties>().verbose = verboseAttr;
  }
  {
    auto loc = parser.getCurrentLocation();(void)loc;
    if (parser.parseOptionalAttrDict(result.attributes))
      return ::mlir::failure();
    if (failed(verifyInherentAttrs(result.name, result.attributes, [&]() {
        return parser.emitError(loc) << "'" << result.name.getStringRef() << "' op ";
      })))
      return ::mlir::failure();
  }
  return ::mlir::success();
}

void TerminateOp::print(::mlir::OpAsmPrinter &_odsPrinter) {
  _odsPrinter << ' ';
  printKeywordBool(_odsPrinter, *this, getSuccessAttr(), "success", "failure");
  _odsPrinter << ",";
  _odsPrinter << ' ';
  printKeywordBool(_odsPrinter, *this, getVerboseAttr(), "verbose", "quiet");
  ::llvm::SmallVector<::llvm::StringRef, 2> elidedAttrs;
  elidedAttrs.push_back("success");
  elidedAttrs.push_back("verbose");
  _odsPrinter.printOptionalAttrDict((*this)->getAttrs(), elidedAttrs);
}


