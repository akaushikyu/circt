::llvm::LogicalResult FormatScientificOp::verifyInherentAttrs(::mlir::OperationName opName, ::mlir::NamedAttrList &attrs, llvm::function_ref<::mlir::InFlightDiagnostic()> emitError) {
    {
      ::mlir::Attribute attr = attrs.get(getFieldWidthAttrName(opName));
      if (attr && ::mlir::failed(__mlir_ods_local_attr_constraint_Sim7(attr, "fieldWidth", emitError)))
        return ::mlir::failure();
    }

    {
      ::mlir::Attribute attr = attrs.get(getFracDigitsAttrName(opName));
      if (attr && ::mlir::failed(__mlir_ods_local_attr_constraint_Sim7(attr, "fracDigits", emitError)))
        return ::mlir::failure();
    }

    {
      ::mlir::Attribute attr = attrs.get(getIsLeftAlignedAttrName(opName));
      if (attr && ::mlir::failed(__mlir_ods_local_attr_constraint_Sim1(attr, "isLeftAligned", emitError)))
        return ::mlir::failure();
    }
    return ::mlir::success();
}

::llvm::LogicalResult FormatScientificOp::readProperties(::mlir::DialectBytecodeReader &reader, ::mlir::OperationState &state) {
