void FormatGeneralOp::print(::mlir::OpAsmPrinter &_odsPrinter) {
  _odsPrinter << ' ';
  _odsPrinter << getValue();
  if (getIsLeftAlignedAttr() != ::mlir::OpBuilder((*this)->getContext()).getBoolAttr(false)) {
    _odsPrinter << ' ' << "isLeftAligned";
    _odsPrinter << ' ';
    _odsPrinter.printAttributeWithoutType(getIsLeftAlignedAttr());
  }
  if (getFieldWidthAttr()) {
    _odsPrinter << ' ' << "fieldWidth";
    _odsPrinter << ' ';
    _odsPrinter.printAttributeWithoutType(getFieldWidthAttr());
  }
  if (getFracDigitsAttr() != ::mlir::OpBuilder((*this)->getContext()).getIntegerAttr(::mlir::OpBuilder((*this)->getContext()).getIntegerType(32), 6)) {
    _odsPrinter << ' ' << "fracDigits";
    _odsPrinter << ' ';
    _odsPrinter.printAttributeWithoutType(getFracDigitsAttr());
  }
  ::llvm::SmallVector<::llvm::StringRef, 2> elidedAttrs;
  elidedAttrs.push_back("isLeftAligned");
  elidedAttrs.push_back("fieldWidth");
  elidedAttrs.push_back("fracDigits");
  {
     ::mlir::Builder odsBuilder(getContext());
     ::mlir::Attribute attr = getIsLeftAlignedAttr();
     if(attr && (attr == odsBuilder.getBoolAttr(false)))
       elidedAttrs.push_back("isLeftAligned");
  }
  {
     ::mlir::Builder odsBuilder(getContext());
     ::mlir::Attribute attr = getFracDigitsAttr();
     if(attr && (attr == odsBuilder.getIntegerAttr(odsBuilder.getIntegerType(32), 6)))
       elidedAttrs.push_back("fracDigits");
  }
  _odsPrinter.printOptionalAttrDict((*this)->getAttrs(), elidedAttrs);
  _odsPrinter << ' ' << ":";
  _odsPrinter << ' ';
   _odsPrinter << getValue().getType();
}

