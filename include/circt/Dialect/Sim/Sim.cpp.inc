::llvm::LogicalResult FormatBinOp::setPropertiesFromAttr(Properties &prop, ::mlir::Attribute attr, ::llvm::function_ref<::mlir::InFlightDiagnostic()> emitError) {
  ::mlir::DictionaryAttr dict = ::llvm::dyn_cast<::mlir::DictionaryAttr>(attr);
  if (!dict) {
    emitError() << "expected DictionaryAttr to set properties";
    return ::mlir::failure();
  }

  {
    auto &propStorage = prop.isLeftAligned;
       auto attr = dict.get("isLeftAligned");
    if (attr) {
      auto convertedAttr = ::llvm::dyn_cast<std::remove_reference_t<decltype(propStorage)>>(attr);
      if (convertedAttr) {
        propStorage = convertedAttr;
      } else {
        emitError() << "Invalid attribute `isLeftAligned` in property conversion: " << attr;
        return ::mlir::failure();
      }
    }
  }

  {
    auto &propStorage = prop.paddingChar;
       auto attr = dict.get("paddingChar");
    if (attr) {
      auto convertedAttr = ::llvm::dyn_cast<std::remove_reference_t<decltype(propStorage)>>(attr);
      if (convertedAttr) {
        propStorage = convertedAttr;
      } else {
        emitError() << "Invalid attribute `paddingChar` in property conversion: " << attr;
        return ::mlir::failure();
      }
    }
  }

  {
    auto &propStorage = prop.specifierWidth;
       auto attr = dict.get("specifierWidth");
    if (attr) {
      auto convertedAttr = ::llvm::dyn_cast<std::remove_reference_t<decltype(propStorage)>>(attr);
      if (convertedAttr) {
        propStorage = convertedAttr;
      } else {
        emitError() << "Invalid attribute `specifierWidth` in property conversion: " << attr;
        return ::mlir::failure();
      }
    }
  }
  return ::mlir::success();
}

::mlir::Attribute FormatBinOp::getPropertiesAsAttr(::mlir::MLIRContext *ctx, const Properties &prop) {
    ::mlir::SmallVector<::mlir::NamedAttribute> attrs;
    ::mlir::Builder odsBuilder{ctx};

    {
      const auto &propStorage = prop.isLeftAligned;
      if (propStorage)
        attrs.push_back(odsBuilder.getNamedAttr("isLeftAligned",
                                       propStorage));
    }

    {
      const auto &propStorage = prop.paddingChar;
      if (propStorage)
        attrs.push_back(odsBuilder.getNamedAttr("paddingChar",
                                       propStorage));
    }

    {
      const auto &propStorage = prop.specifierWidth;
      if (propStorage)
        attrs.push_back(odsBuilder.getNamedAttr("specifierWidth",
                                       propStorage));
    }

  if (!attrs.empty())
    return odsBuilder.getDictionaryAttr(attrs);
  return {};
}

llvm::hash_code FormatBinOp::computePropertiesHash(const Properties &prop) {
  using llvm::hash_value;
  return llvm::hash_combine(
    llvm::hash_value(prop.isLeftAligned.getAsOpaquePointer()), 
    llvm::hash_value(prop.paddingChar.getAsOpaquePointer()), 
    llvm::hash_value(prop.specifierWidth.getAsOpaquePointer()));
}

std::optional<mlir::Attribute> FormatBinOp::getInherentAttr(::mlir::MLIRContext *ctx, const Properties &prop, llvm::StringRef name) {
    if (name == "isLeftAligned")
      return prop.isLeftAligned;

    if (name == "paddingChar")
      return prop.paddingChar;

    if (name == "specifierWidth")
      return prop.specifierWidth;
  return std::nullopt;
}

void FormatBinOp::setInherentAttr(Properties &prop, llvm::StringRef name, mlir::Attribute value) {
    if (name == "isLeftAligned") {
       prop.isLeftAligned = ::llvm::dyn_cast_or_null<std::remove_reference_t<decltype(prop.isLeftAligned)>>(value);
       return;
    }

    if (name == "paddingChar") {
       prop.paddingChar = ::llvm::dyn_cast_or_null<std::remove_reference_t<decltype(prop.paddingChar)>>(value);
       return;
    }

    if (name == "specifierWidth") {
       prop.specifierWidth = ::llvm::dyn_cast_or_null<std::remove_reference_t<decltype(prop.specifierWidth)>>(value);
       return;
    }
}

void FormatBinOp::populateInherentAttrs(::mlir::MLIRContext *ctx, const Properties &prop, ::mlir::NamedAttrList &attrs) {
    if (prop.isLeftAligned) attrs.append("isLeftAligned", prop.isLeftAligned);

    if (prop.paddingChar) attrs.append("paddingChar", prop.paddingChar);

    if (prop.specifierWidth) attrs.append("specifierWidth", prop.specifierWidth);
}

::llvm::LogicalResult FormatBinOp::verifyInherentAttrs(::mlir::OperationName opName, ::mlir::NamedAttrList &attrs, llvm::function_ref<::mlir::InFlightDiagnostic()> emitError) {
    {
      ::mlir::Attribute attr = attrs.get(getIsLeftAlignedAttrName(opName));
      if (attr && ::mlir::failed(__mlir_ods_local_attr_constraint_Sim1(attr, "isLeftAligned", emitError)))
        return ::mlir::failure();
    }

    {
      ::mlir::Attribute attr = attrs.get(getPaddingCharAttrName(opName));
      if (attr && ::mlir::failed(__mlir_ods_local_attr_constraint_Sim6(attr, "paddingChar", emitError)))
        return ::mlir::failure();
    }

    {
      ::mlir::Attribute attr = attrs.get(getSpecifierWidthAttrName(opName));
      if (attr && ::mlir::failed(__mlir_ods_local_attr_constraint_Sim7(attr, "specifierWidth", emitError)))
        return ::mlir::failure();
    }
    return ::mlir::success();
}

::llvm::LogicalResult FormatBinOp::readProperties(::mlir::DialectBytecodeReader &reader, ::mlir::OperationState &state) {
  auto &prop = state.getOrAddProperties<Properties>(); (void)prop;
  if (::mlir::failed(reader.readOptionalAttribute(prop.isLeftAligned)))
    return ::mlir::failure();

  if (::mlir::failed(reader.readOptionalAttribute(prop.paddingChar)))
    return ::mlir::failure();

  if (::mlir::failed(reader.readOptionalAttribute(prop.specifierWidth)))
    return ::mlir::failure();
  return ::mlir::success();
}

void FormatBinOp::writeProperties(::mlir::DialectBytecodeWriter &writer) {
  auto &prop = getProperties(); (void)prop;

  writer.writeOptionalAttribute(prop.isLeftAligned);

  writer.writeOptionalAttribute(prop.paddingChar);

  writer.writeOptionalAttribute(prop.specifierWidth);
}

