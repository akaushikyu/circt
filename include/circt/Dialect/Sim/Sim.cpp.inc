::llvm::LogicalResult TerminateOpAdaptor::verify(::mlir::Location loc) {
  auto tblgen_success = getProperties().success; (void)tblgen_success;
  if (!tblgen_success) return emitError(loc, "'sim.terminate' op requires attribute 'success'");
  auto tblgen_verbose = getProperties().verbose; (void)tblgen_verbose;
  if (!tblgen_verbose) return emitError(loc, "'sim.terminate' op requires attribute 'verbose'");

  if (tblgen_success && !((::llvm::isa<::mlir::BoolAttr>(tblgen_success))))
    return emitError(loc, "'sim.terminate' op attribute 'success' failed to satisfy constraint: bool attribute");

  if (tblgen_verbose && !((::llvm::isa<::mlir::BoolAttr>(tblgen_verbose))))
    return emitError(loc, "'sim.terminate' op attribute 'verbose' failed to satisfy constraint: bool attribute");
  return ::mlir::success();
}

::llvm::LogicalResult TerminateOp::setPropertiesFromAttr(Properties &prop, ::mlir::Attribute attr, ::llvm::function_ref<::mlir::InFlightDiagnostic()> emitError) {
  ::mlir::DictionaryAttr dict = ::llvm::dyn_cast<::mlir::DictionaryAttr>(attr);
  if (!dict) {
    emitError() << "expected DictionaryAttr to set properties";
    return ::mlir::failure();
  }

  {
    auto &propStorage = prop.success;
       auto attr = dict.get("success");
    if (attr) {
      auto convertedAttr = ::llvm::dyn_cast<std::remove_reference_t<decltype(propStorage)>>(attr);
      if (convertedAttr) {
        propStorage = convertedAttr;
      } else {
        emitError() << "Invalid attribute `success` in property conversion: " << attr;
        return ::mlir::failure();
      }
    }
  }

  {
    auto &propStorage = prop.verbose;
       auto attr = dict.get("verbose");
    if (attr) {
      auto convertedAttr = ::llvm::dyn_cast<std::remove_reference_t<decltype(propStorage)>>(attr);
      if (convertedAttr) {
        propStorage = convertedAttr;
      } else {
        emitError() << "Invalid attribute `verbose` in property conversion: " << attr;
        return ::mlir::failure();
      }
    }
  }
  return ::mlir::success();
}

::mlir::Attribute TerminateOp::getPropertiesAsAttr(::mlir::MLIRContext *ctx, const Properties &prop) {
    ::mlir::SmallVector<::mlir::NamedAttribute> attrs;
    ::mlir::Builder odsBuilder{ctx};

    {
      const auto &propStorage = prop.success;
      if (propStorage)
        attrs.push_back(odsBuilder.getNamedAttr("success",
                                       propStorage));
    }

    {
      const auto &propStorage = prop.verbose;
      if (propStorage)
        attrs.push_back(odsBuilder.getNamedAttr("verbose",
                                       propStorage));
    }

  if (!attrs.empty())
    return odsBuilder.getDictionaryAttr(attrs);
  return {};
}

