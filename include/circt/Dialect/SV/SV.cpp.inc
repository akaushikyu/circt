::llvm::LogicalResult XMRRefOpAdaptor::verify(::mlir::Location loc) {
  auto tblgen_ref = getProperties().ref; (void)tblgen_ref;
  if (!tblgen_ref) return emitError(loc, "'sv.xmr.ref' op requires attribute 'ref'");
  auto tblgen_verbatimSuffix = getProperties().verbatimSuffix; (void)tblgen_verbatimSuffix;

  if (tblgen_ref && !((::llvm::isa<::mlir::FlatSymbolRefAttr>(tblgen_ref))))
    return emitError(loc, "'sv.xmr.ref' op attribute 'ref' failed to satisfy constraint: flat symbol reference attribute");

  if (tblgen_verbatimSuffix && !((::llvm::isa<::mlir::StringAttr>(tblgen_verbatimSuffix))))
    return emitError(loc, "'sv.xmr.ref' op attribute 'verbatimSuffix' failed to satisfy constraint: string attribute");
  return ::mlir::success();
}

::llvm::LogicalResult XMRRefOp::setPropertiesFromAttr(Properties &prop, ::mlir::Attribute attr, ::llvm::function_ref<::mlir::InFlightDiagnostic()> emitError) {
  ::mlir::DictionaryAttr dict = ::llvm::dyn_cast<::mlir::DictionaryAttr>(attr);
  if (!dict) {
    emitError() << "expected DictionaryAttr to set properties";
    return ::mlir::failure();
  }

  {
    auto &propStorage = prop.ref;
       auto attr = dict.get("ref");
    if (attr) {
      auto convertedAttr = ::llvm::dyn_cast<std::remove_reference_t<decltype(propStorage)>>(attr);
      if (convertedAttr) {
        propStorage = convertedAttr;
      } else {
        emitError() << "Invalid attribute `ref` in property conversion: " << attr;
        return ::mlir::failure();
      }
    }
  }

  {
    auto &propStorage = prop.verbatimSuffix;
       auto attr = dict.get("verbatimSuffix");
    if (attr) {
      auto convertedAttr = ::llvm::dyn_cast<std::remove_reference_t<decltype(propStorage)>>(attr);
      if (convertedAttr) {
        propStorage = convertedAttr;
      } else {
        emitError() << "Invalid attribute `verbatimSuffix` in property conversion: " << attr;
        return ::mlir::failure();
      }
    }
  }
  return ::mlir::success();
}

::mlir::Attribute XMRRefOp::getPropertiesAsAttr(::mlir::MLIRContext *ctx, const Properties &prop) {
    ::mlir::SmallVector<::mlir::NamedAttribute> attrs;
    ::mlir::Builder odsBuilder{ctx};

    {
      const auto &propStorage = prop.ref;
      if (propStorage)
        attrs.push_back(odsBuilder.getNamedAttr("ref",
                                       propStorage));
    }

    {
      const auto &propStorage = prop.verbatimSuffix;
      if (propStorage)
        attrs.push_back(odsBuilder.getNamedAttr("verbatimSuffix",
                                       propStorage));
    }

  if (!attrs.empty())
    return odsBuilder.getDictionaryAttr(attrs);
  return {};
}

llvm::hash_code XMRRefOp::computePropertiesHash(const Properties &prop) {
  using llvm::hash_value;
  return llvm::hash_combine(
    llvm::hash_value(prop.ref.getAsOpaquePointer()), 
    llvm::hash_value(prop.verbatimSuffix.getAsOpaquePointer()));
}

std::optional<mlir::Attribute> XMRRefOp::getInherentAttr(::mlir::MLIRContext *ctx, const Properties &prop, llvm::StringRef name) {
    if (name == "ref")
      return prop.ref;

    if (name == "verbatimSuffix")
      return prop.verbatimSuffix;
  return std::nullopt;
}

void XMRRefOp::setInherentAttr(Properties &prop, llvm::StringRef name, mlir::Attribute value) {
    if (name == "ref") {
       prop.ref = ::llvm::dyn_cast_or_null<std::remove_reference_t<decltype(prop.ref)>>(value);
       return;
    }

    if (name == "verbatimSuffix") {
       prop.verbatimSuffix = ::llvm::dyn_cast_or_null<std::remove_reference_t<decltype(prop.verbatimSuffix)>>(value);
       return;
    }
}

void XMRRefOp::populateInherentAttrs(::mlir::MLIRContext *ctx, const Properties &prop, ::mlir::NamedAttrList &attrs) {
    if (prop.ref) attrs.append("ref", prop.ref);

    if (prop.verbatimSuffix) attrs.append("verbatimSuffix", prop.verbatimSuffix);
}

::llvm::LogicalResult XMRRefOp::verifyInherentAttrs(::mlir::OperationName opName, ::mlir::NamedAttrList &attrs, llvm::function_ref<::mlir::InFlightDiagnostic()> emitError) {
    {
      ::mlir::Attribute attr = attrs.get(getRefAttrName(opName));
      if (attr && ::mlir::failed(__mlir_ods_local_attr_constraint_SV6(attr, "ref", emitError)))
        return ::mlir::failure();
    }

    {
      ::mlir::Attribute attr = attrs.get(getVerbatimSuffixAttrName(opName));
      if (attr && ::mlir::failed(__mlir_ods_local_attr_constraint_SV4(attr, "verbatimSuffix", emitError)))
        return ::mlir::failure();
    }
    return ::mlir::success();
}

::llvm::LogicalResult XMRRefOp::readProperties(::mlir::DialectBytecodeReader &reader, ::mlir::OperationState &state) {
  auto &prop = state.getOrAddProperties<Properties>(); (void)prop;
  if (::mlir::failed(reader.readAttribute(prop.ref)))
    return ::mlir::failure();

  if (::mlir::failed(reader.readOptionalAttribute(prop.verbatimSuffix)))
    return ::mlir::failure();
  return ::mlir::success();
}

void XMRRefOp::writeProperties(::mlir::DialectBytecodeWriter &writer) {
  auto &prop = getProperties(); (void)prop;
  writer.writeAttribute(prop.ref);

  writer.writeOptionalAttribute(prop.verbatimSuffix);
}

