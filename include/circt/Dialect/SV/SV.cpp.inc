::llvm::LogicalResult CaseOp::verifyInvariantsImpl() {
  auto tblgen_casePatterns = getProperties().casePatterns; (void)tblgen_casePatterns;
  if (!tblgen_casePatterns) return emitOpError("requires attribute 'casePatterns'");
  auto tblgen_caseStyle = getProperties().caseStyle; (void)tblgen_caseStyle;
  auto tblgen_validationQualifier = getProperties().validationQualifier; (void)tblgen_validationQualifier;

  if (::mlir::failed(__mlir_ods_local_attr_constraint_SV8(*this, tblgen_caseStyle, "caseStyle")))
    return ::mlir::failure();

  if (::mlir::failed(__mlir_ods_local_attr_constraint_SV9(*this, tblgen_casePatterns, "casePatterns")))
    return ::mlir::failure();

  if (::mlir::failed(__mlir_ods_local_attr_constraint_SV10(*this, tblgen_validationQualifier, "validationQualifier")))
    return ::mlir::failure();
  {
    unsigned index = 0; (void)index;
    auto valueGroup0 = getODSOperands(0);

    for (auto v : valueGroup0) {
      if (::mlir::failed(__mlir_ods_local_type_constraint_SV10(*this, v.getType(), "operand", index++)))
        return ::mlir::failure();
    }
    auto valueGroup1 = getODSOperands(1);

    for (auto v : valueGroup1) {
      if (::mlir::failed(__mlir_ods_local_type_constraint_SV7(*this, v.getType(), "operand", index++)))
        return ::mlir::failure();
    }
  }
  {
    unsigned index = 0; (void)index;

    for (auto &region : getCaseRegions())
      if (::mlir::failed(__mlir_ods_local_region_constraint_SV1(*this, region, "caseRegions", index++)))
        return ::mlir::failure();
  }
  return ::mlir::success();
}

::llvm::LogicalResult CaseOp::verifyInvariants() {
  if(::mlir::succeeded(verifyInvariantsImpl()) && ::mlir::succeeded(verify()))
    return ::mlir::success();
  return ::mlir::failure();
}

