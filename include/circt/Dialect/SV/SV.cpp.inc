::llvm::LogicalResult AssignInterfaceSignalOpAdaptor::verify(::mlir::Location loc) {
  auto tblgen_signalName = getProperties().signalName; (void)tblgen_signalName;
  if (!tblgen_signalName) return emitError(loc, "'sv.interface.signal.assign' op requires attribute 'signalName'");

  if (tblgen_signalName && !((::llvm::isa<::mlir::FlatSymbolRefAttr>(tblgen_signalName))))
    return emitError(loc, "'sv.interface.signal.assign' op attribute 'signalName' failed to satisfy constraint: flat symbol reference attribute");
  return ::mlir::success();
