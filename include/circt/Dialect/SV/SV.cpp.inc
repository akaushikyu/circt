::llvm::LogicalResult CaseOpAdaptor::verify(::mlir::Location loc) {
  auto tblgen_casePatterns = getProperties().casePatterns; (void)tblgen_casePatterns;
  if (!tblgen_casePatterns) return emitError(loc, "'sv.case' op requires attribute 'casePatterns'");
  auto tblgen_caseStyle = getProperties().caseStyle; (void)tblgen_caseStyle;
  auto tblgen_validationQualifier = getProperties().validationQualifier; (void)tblgen_validationQualifier;

  if (tblgen_caseStyle && !((::llvm::isa<::CaseStmtTypeAttr>(tblgen_caseStyle))))
    return emitError(loc, "'sv.case' op attribute 'caseStyle' failed to satisfy constraint: case type");

  if (tblgen_casePatterns && !((::llvm::isa<::mlir::ArrayAttr>(tblgen_casePatterns))))
    return emitError(loc, "'sv.case' op attribute 'casePatterns' failed to satisfy constraint: array attribute");

  if (tblgen_validationQualifier && !((::llvm::isa<::circt::sv::ValidationQualifierTypeEnumAttr>(tblgen_validationQualifier))))
    return emitError(loc, "'sv.case' op attribute 'validationQualifier' failed to satisfy constraint: validation qualifier type");
  return ::mlir::success();
}

std::pair<unsigned, unsigned> CaseOp::getODSOperandIndexAndLength(unsigned index) {
  bool isVariadic[] = {false, true};
  int prevVariadicCount = 0;
  for (unsigned i = 0; i < index; ++i)
    if (isVariadic[i]) ++prevVariadicCount;

  // Calculate how many dynamic values a static variadic operand corresponds to.
  // This assumes all static variadic operands have the same dynamic value count.
  int variadicSize = (getOperation()->getNumOperands() - 1) / 1;
  // `index` passed in as the parameter is the static index which counts each
  // operand (variadic or not) as size 1. So here for each previous static variadic
  // operand, we need to offset by (variadicSize - 1) to get where the dynamic
  // value pack for this static operand starts.
  int start = index + (variadicSize - 1) * prevVariadicCount;
  int size = isVariadic[index] ? variadicSize : 1;
  return {start, size};
}

::mlir::MutableOperandRange CaseOp::getCaseValuesMutable() {
  auto range = getODSOperandIndexAndLength(1);
  auto mutableRange = ::mlir::MutableOperandRange(getOperation(), range.first, range.second);
  return mutableRange;
}

::llvm::LogicalResult CaseOp::setPropertiesFromAttr(Properties &prop, ::mlir::Attribute attr, ::llvm::function_ref<::mlir::InFlightDiagnostic()> emitError) {
  ::mlir::DictionaryAttr dict = ::llvm::dyn_cast<::mlir::DictionaryAttr>(attr);
  if (!dict) {
    emitError() << "expected DictionaryAttr to set properties";
    return ::mlir::failure();
  }

  {
    auto &propStorage = prop.casePatterns;
       auto attr = dict.get("casePatterns");
    if (attr) {
      auto convertedAttr = ::llvm::dyn_cast<std::remove_reference_t<decltype(propStorage)>>(attr);
      if (convertedAttr) {
        propStorage = convertedAttr;
      } else {
        emitError() << "Invalid attribute `casePatterns` in property conversion: " << attr;
        return ::mlir::failure();
      }
    }
  }

  {
    auto &propStorage = prop.caseStyle;
       auto attr = dict.get("caseStyle");
    if (attr) {
      auto convertedAttr = ::llvm::dyn_cast<std::remove_reference_t<decltype(propStorage)>>(attr);
      if (convertedAttr) {
        propStorage = convertedAttr;
      } else {
        emitError() << "Invalid attribute `caseStyle` in property conversion: " << attr;
        return ::mlir::failure();
      }
    }
  }

  {
    auto &propStorage = prop.validationQualifier;
       auto attr = dict.get("validationQualifier");
    if (attr) {
      auto convertedAttr = ::llvm::dyn_cast<std::remove_reference_t<decltype(propStorage)>>(attr);
      if (convertedAttr) {
        propStorage = convertedAttr;
      } else {
        emitError() << "Invalid attribute `validationQualifier` in property conversion: " << attr;
        return ::mlir::failure();
      }
    }
  }
  return ::mlir::success();
}

::mlir::Attribute CaseOp::getPropertiesAsAttr(::mlir::MLIRContext *ctx, const Properties &prop) {
    ::mlir::SmallVector<::mlir::NamedAttribute> attrs;
    ::mlir::Builder odsBuilder{ctx};

    {
      const auto &propStorage = prop.casePatterns;
      if (propStorage)
        attrs.push_back(odsBuilder.getNamedAttr("casePatterns",
                                       propStorage));
    }

    {
      const auto &propStorage = prop.caseStyle;
      if (propStorage)
        attrs.push_back(odsBuilder.getNamedAttr("caseStyle",
                                       propStorage));
    }

    {
      const auto &propStorage = prop.validationQualifier;
      if (propStorage)
        attrs.push_back(odsBuilder.getNamedAttr("validationQualifier",
                                       propStorage));
    }

  if (!attrs.empty())
    return odsBuilder.getDictionaryAttr(attrs);
  return {};
}

llvm::hash_code CaseOp::computePropertiesHash(const Properties &prop) {
  using llvm::hash_value;
  return llvm::hash_combine(
    llvm::hash_value(prop.casePatterns.getAsOpaquePointer()), 
    llvm::hash_value(prop.caseStyle.getAsOpaquePointer()), 
    llvm::hash_value(prop.validationQualifier.getAsOpaquePointer()));
}

std::optional<mlir::Attribute> CaseOp::getInherentAttr(::mlir::MLIRContext *ctx, const Properties &prop, llvm::StringRef name) {
    if (name == "casePatterns")
      return prop.casePatterns;

    if (name == "caseStyle")
      return prop.caseStyle;

    if (name == "validationQualifier")
      return prop.validationQualifier;
  return std::nullopt;
}

void CaseOp::setInherentAttr(Properties &prop, llvm::StringRef name, mlir::Attribute value) {
    if (name == "casePatterns") {
       prop.casePatterns = ::llvm::dyn_cast_or_null<std::remove_reference_t<decltype(prop.casePatterns)>>(value);
       return;
    }

    if (name == "caseStyle") {
       prop.caseStyle = ::llvm::dyn_cast_or_null<std::remove_reference_t<decltype(prop.caseStyle)>>(value);
       return;
    }

    if (name == "validationQualifier") {
       prop.validationQualifier = ::llvm::dyn_cast_or_null<std::remove_reference_t<decltype(prop.validationQualifier)>>(value);
       return;
    }
}

void CaseOp::populateInherentAttrs(::mlir::MLIRContext *ctx, const Properties &prop, ::mlir::NamedAttrList &attrs) {
    if (prop.casePatterns) attrs.append("casePatterns", prop.casePatterns);

    if (prop.caseStyle) attrs.append("caseStyle", prop.caseStyle);

    if (prop.validationQualifier) attrs.append("validationQualifier", prop.validationQualifier);
}

::llvm::LogicalResult CaseOp::verifyInherentAttrs(::mlir::OperationName opName, ::mlir::NamedAttrList &attrs, llvm::function_ref<::mlir::InFlightDiagnostic()> emitError) {
    {
      ::mlir::Attribute attr = attrs.get(getCasePatternsAttrName(opName));
      if (attr && ::mlir::failed(__mlir_ods_local_attr_constraint_SV9(attr, "casePatterns", emitError)))
        return ::mlir::failure();
    }

    {
      ::mlir::Attribute attr = attrs.get(getCaseStyleAttrName(opName));
      if (attr && ::mlir::failed(__mlir_ods_local_attr_constraint_SV8(attr, "caseStyle", emitError)))
        return ::mlir::failure();
    }

    {
      ::mlir::Attribute attr = attrs.get(getValidationQualifierAttrName(opName));
      if (attr && ::mlir::failed(__mlir_ods_local_attr_constraint_SV10(attr, "validationQualifier", emitError)))
        return ::mlir::failure();
    }
    return ::mlir::success();
}

::llvm::LogicalResult CaseOp::readProperties(::mlir::DialectBytecodeReader &reader, ::mlir::OperationState &state) {
  auto &prop = state.getOrAddProperties<Properties>(); (void)prop;
  if (::mlir::failed(reader.readAttribute(prop.casePatterns)))
    return ::mlir::failure();

  if (::mlir::failed(reader.readOptionalAttribute(prop.caseStyle)))
    return ::mlir::failure();

  if (::mlir::failed(reader.readOptionalAttribute(prop.validationQualifier)))
    return ::mlir::failure();
  return ::mlir::success();
}

void CaseOp::writeProperties(::mlir::DialectBytecodeWriter &writer) {
  auto &prop = getProperties(); (void)prop;
  writer.writeAttribute(prop.casePatterns);

  writer.writeOptionalAttribute(prop.caseStyle);

  writer.writeOptionalAttribute(prop.validationQualifier);
}

