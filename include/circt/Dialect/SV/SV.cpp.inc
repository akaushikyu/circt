void SVVerbatimModuleOp::build(::mlir::OpBuilder &odsBuilder, ::mlir::OperationState &odsState, StringAttr name, ArrayRef<hw::PortInfo> ports, FlatSymbolRefAttr source, ArrayAttr parameters, StringAttr verilogName) {
      SmallVector<hw::ModulePort> modulePorts;
      SmallVector<Attribute> portAttrs, portLocs;
      for (const auto &port : ports) {
        Type portType = port.type;
        hw::ModulePort::Direction portDir = port.dir;
        if (auto inoutType = dyn_cast<hw::InOutType>(port.type)) {
          portType = inoutType.getElementType();
          portDir = hw::ModulePort::Direction::InOut;
        }
        modulePorts.push_back({port.name, portType, portDir});
        portAttrs.push_back(port.attrs ? port.attrs : odsBuilder.getDictionaryAttr({}));
        portLocs.push_back(port.loc ? static_cast<Location>(port.loc) : odsBuilder.getUnknownLoc());
      }
      auto moduleType = hw::ModuleType::get(odsBuilder.getContext(), modulePorts);
      build(odsBuilder, odsState, name, TypeAttr::get(moduleType),
            odsBuilder.getArrayAttr(portAttrs), odsBuilder.getArrayAttr(portLocs),
            parameters, source, verilogName);
    
}

SVVerbatimModuleOp SVVerbatimModuleOp::create(::mlir::OpBuilder &builder, ::mlir::Location location, StringAttr name, ArrayRef<hw::PortInfo> ports, FlatSymbolRefAttr source, ArrayAttr parameters, StringAttr verilogName) {
  ::mlir::OperationState __state__(location, getOperationName());
  build(builder, __state__, std::forward<decltype(name)>(name), std::forward<decltype(ports)>(ports), std::forward<decltype(source)>(source), std::forward<decltype(parameters)>(parameters), std::forward<decltype(verilogName)>(verilogName));
  auto __res__ = ::llvm::dyn_cast<SVVerbatimModuleOp>(builder.create(__state__));
  assert(__res__ && "builder didn't return the right type");
  return __res__;
}

