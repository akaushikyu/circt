    return emitError(loc, "'sv.generate.case' op attribute 'cond' failed to satisfy constraint: TypedAttr instance");

  if (tblgen_casePatterns && !(((::llvm::isa<::mlir::ArrayAttr>(tblgen_casePatterns))) && (::llvm::all_of(::llvm::cast<::mlir::ArrayAttr>(tblgen_casePatterns), [&](::mlir::Attribute attr) { return attr && (((::llvm::isa<::mlir::TypedAttr>(attr))) || ((::llvm::isa<::mlir::UnitAttr>(attr)))); }))))
