::llvm::LogicalResult ReadMemOpAdaptor::verify(::mlir::Location loc) {
  auto tblgen_base = getProperties().base; (void)tblgen_base;
  if (!tblgen_base) return emitError(loc, "'sv.readmem' op requires attribute 'base'");
  auto tblgen_filename = getProperties().filename; (void)tblgen_filename;
  if (!tblgen_filename) return emitError(loc, "'sv.readmem' op requires attribute 'filename'");

  if (tblgen_filename && !((::llvm::isa<::mlir::StringAttr>(tblgen_filename))))
    return emitError(loc, "'sv.readmem' op attribute 'filename' failed to satisfy constraint: string attribute");

  if (tblgen_base && !((::llvm::isa<::MemBaseTypeAttrAttr>(tblgen_base))))
    return emitError(loc, "'sv.readmem' op attribute 'base' failed to satisfy constraint: the numeric base of a memory file");
  return ::mlir::success();
}

::llvm::LogicalResult ReadMemOp::setPropertiesFromAttr(Properties &prop, ::mlir::Attribute attr, ::llvm::function_ref<::mlir::InFlightDiagnostic()> emitError) {
  ::mlir::DictionaryAttr dict = ::llvm::dyn_cast<::mlir::DictionaryAttr>(attr);
  if (!dict) {
    emitError() << "expected DictionaryAttr to set properties";
    return ::mlir::failure();
  }

  {
    auto &propStorage = prop.base;
       auto attr = dict.get("base");
    if (attr) {
      auto convertedAttr = ::llvm::dyn_cast<std::remove_reference_t<decltype(propStorage)>>(attr);
      if (convertedAttr) {
        propStorage = convertedAttr;
      } else {
        emitError() << "Invalid attribute `base` in property conversion: " << attr;
        return ::mlir::failure();
      }
    }
  }

  {
    auto &propStorage = prop.filename;
       auto attr = dict.get("filename");
    if (attr) {
      auto convertedAttr = ::llvm::dyn_cast<std::remove_reference_t<decltype(propStorage)>>(attr);
      if (convertedAttr) {
        propStorage = convertedAttr;
      } else {
        emitError() << "Invalid attribute `filename` in property conversion: " << attr;
        return ::mlir::failure();
      }
    }
  }
  return ::mlir::success();
}

::mlir::Attribute ReadMemOp::getPropertiesAsAttr(::mlir::MLIRContext *ctx, const Properties &prop) {
    ::mlir::SmallVector<::mlir::NamedAttribute> attrs;
    ::mlir::Builder odsBuilder{ctx};

    {
      const auto &propStorage = prop.base;
      if (propStorage)
        attrs.push_back(odsBuilder.getNamedAttr("base",
                                       propStorage));
    }

    {
      const auto &propStorage = prop.filename;
      if (propStorage)
        attrs.push_back(odsBuilder.getNamedAttr("filename",
                                       propStorage));
    }

  if (!attrs.empty())
    return odsBuilder.getDictionaryAttr(attrs);
  return {};
}

llvm::hash_code ReadMemOp::computePropertiesHash(const Properties &prop) {
  using llvm::hash_value;
  return llvm::hash_combine(
    llvm::hash_value(prop.base.getAsOpaquePointer()), 
    llvm::hash_value(prop.filename.getAsOpaquePointer()));
}

std::optional<mlir::Attribute> ReadMemOp::getInherentAttr(::mlir::MLIRContext *ctx, const Properties &prop, llvm::StringRef name) {
    if (name == "base")
      return prop.base;

    if (name == "filename")
      return prop.filename;
  return std::nullopt;
}

void ReadMemOp::setInherentAttr(Properties &prop, llvm::StringRef name, mlir::Attribute value) {
    if (name == "base") {
       prop.base = ::llvm::dyn_cast_or_null<std::remove_reference_t<decltype(prop.base)>>(value);
       return;
    }

    if (name == "filename") {
       prop.filename = ::llvm::dyn_cast_or_null<std::remove_reference_t<decltype(prop.filename)>>(value);
       return;
    }
}

void ReadMemOp::populateInherentAttrs(::mlir::MLIRContext *ctx, const Properties &prop, ::mlir::NamedAttrList &attrs) {
    if (prop.base) attrs.append("base", prop.base);

    if (prop.filename) attrs.append("filename", prop.filename);
}

::llvm::LogicalResult ReadMemOp::verifyInherentAttrs(::mlir::OperationName opName, ::mlir::NamedAttrList &attrs, llvm::function_ref<::mlir::InFlightDiagnostic()> emitError) {
    {
      ::mlir::Attribute attr = attrs.get(getBaseAttrName(opName));
      if (attr && ::mlir::failed(__mlir_ods_local_attr_constraint_SV27(attr, "base", emitError)))
        return ::mlir::failure();
    }

    {
      ::mlir::Attribute attr = attrs.get(getFilenameAttrName(opName));
      if (attr && ::mlir::failed(__mlir_ods_local_attr_constraint_SV4(attr, "filename", emitError)))
        return ::mlir::failure();
    }
    return ::mlir::success();
}

