    if (prop.event) attrs.append("event", prop.event);

    if (prop.label) attrs.append("label", prop.label);
  attrs.append("operandSegmentSizes", [&]() -> ::mlir::Attribute { return ::mlir::DenseI32ArrayAttr::get(ctx, prop.operandSegmentSizes); }());
