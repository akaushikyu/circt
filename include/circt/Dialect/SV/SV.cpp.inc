      auto attrOptional = circt::sv::symbolizeEventControl(attrStr);
      if (!attrOptional)
        return parser.emitError(loc, "invalid ")
               << "resetEdge attribute specification: \"" << attrStr << '"';;

      resetEdgeAttr = circt::sv::EventControlAttr::get(parser.getBuilder().getContext(), *attrOptional);
        result.getOrAddProperties<AlwaysFFOp::Properties>().resetEdge = resetEdgeAttr;
