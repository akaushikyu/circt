::llvm::LogicalResult CoverConcurrentOp::verifyInvariantsImpl() {
  auto tblgen_event = getProperties().event; (void)tblgen_event;
  if (!tblgen_event) return emitOpError("requires attribute 'event'");
  auto tblgen_label = getProperties().label; (void)tblgen_label;
  auto tblgen_message = getProperties().message; (void)tblgen_message;

  if (::mlir::failed(__mlir_ods_local_attr_constraint_SV1(*this, tblgen_event, "event")))
    return ::mlir::failure();

  if (::mlir::failed(__mlir_ods_local_attr_constraint_SV4(*this, tblgen_label, "label")))
    return ::mlir::failure();

  if (::mlir::failed(__mlir_ods_local_attr_constraint_SV4(*this, tblgen_message, "message")))
    return ::mlir::failure();
  {
    unsigned index = 0; (void)index;
    auto valueGroup0 = getODSOperands(0);

    for (auto v : valueGroup0) {
      if (::mlir::failed(__mlir_ods_local_type_constraint_SV2(*this, v.getType(), "operand", index++)))
        return ::mlir::failure();
    }
    auto valueGroup1 = getODSOperands(1);

    for (auto v : valueGroup1) {
      if (::mlir::failed(__mlir_ods_local_type_constraint_SV2(*this, v.getType(), "operand", index++)))
        return ::mlir::failure();
    }
    auto valueGroup2 = getODSOperands(2);

    for (auto v : valueGroup2) {
      if (::mlir::failed(__mlir_ods_local_type_constraint_SV7(*this, v.getType(), "operand", index++)))
        return ::mlir::failure();
    }
  }
  if (!(((getMessage() && !getMessage()->empty()) || this->getODSOperands(2).empty())))
    return emitOpError("failed to verify that has message if has substitutions");
  if (!((!getMessage() && this->getODSOperands(2).empty())))
    return emitOpError("failed to verify that has no message");
  return ::mlir::success();
}

::llvm::LogicalResult CoverConcurrentOp::verifyInvariants() {
  return verifyInvariantsImpl();
}

::mlir::ParseResult CoverConcurrentOp::parse(::mlir::OpAsmParser &parser, ::mlir::OperationState &result) {
  circt::sv::EventControlAttr eventAttr;
  ::mlir::OpAsmParser::UnresolvedOperand clockRawOperand{};
  ::llvm::ArrayRef<::mlir::OpAsmParser::UnresolvedOperand> clockOperands(&clockRawOperand, 1);  ::llvm::SMLoc clockOperandsLoc;
  (void)clockOperandsLoc;
  ::mlir::OpAsmParser::UnresolvedOperand propertyRawOperand{};
  ::llvm::ArrayRef<::mlir::OpAsmParser::UnresolvedOperand> propertyOperands(&propertyRawOperand, 1);  ::llvm::SMLoc propertyOperandsLoc;
  (void)propertyOperandsLoc;
  ::mlir::StringAttr labelAttr;
  ::mlir::StringAttr messageAttr;
  ::llvm::SmallVector<::mlir::OpAsmParser::UnresolvedOperand, 4> substitutionsOperands;
  ::llvm::SMLoc substitutionsOperandsLoc;
  (void)substitutionsOperandsLoc;
  ::llvm::SmallVector<::mlir::Type, 1> substitutionsTypes;

  {
    ::llvm::StringRef attrStr;
    ::mlir::NamedAttrList attrStorage;
    auto loc = parser.getCurrentLocation();
    if (parser.parseOptionalKeyword(&attrStr, {"posedge","negedge","edge"})) {
      ::mlir::StringAttr attrVal;
      ::mlir::OptionalParseResult parseResult =
        parser.parseOptionalAttribute(attrVal,
                                      parser.getBuilder().getNoneType(),
                                      "event", attrStorage);
      if (parseResult.has_value()) {
        if (failed(*parseResult))
          return ::mlir::failure();
        attrStr = attrVal.getValue();
      } else {
        return parser.emitError(loc, "expected string or keyword containing one of the following enum values for attribute 'event' [posedge, negedge, edge]");
      }
    }
    if (!attrStr.empty()) {
      auto attrOptional = circt::sv::symbolizeEventControl(attrStr);
      if (!attrOptional)
        return parser.emitError(loc, "invalid ")
               << "event attribute specification: \"" << attrStr << '"';;

      eventAttr = circt::sv::EventControlAttr::get(parser.getBuilder().getContext(), *attrOptional);
        result.getOrAddProperties<CoverConcurrentOp::Properties>().event = eventAttr;
    }
  }

  clockOperandsLoc = parser.getCurrentLocation();
  if (parser.parseOperand(clockRawOperand))
    return ::mlir::failure();
  if (parser.parseComma())
    return ::mlir::failure();

  propertyOperandsLoc = parser.getCurrentLocation();
  if (parser.parseOperand(propertyRawOperand))
    return ::mlir::failure();
  if (::mlir::succeeded(parser.parseOptionalKeyword("label"))) {

  if (parser.parseCustomAttributeWithFallback(labelAttr, parser.getBuilder().getType<::mlir::NoneType>())) {
    return ::mlir::failure();
  }
  if (labelAttr) result.getOrAddProperties<CoverConcurrentOp::Properties>().label = labelAttr;
  }
  if (::mlir::succeeded(parser.parseOptionalKeyword("message"))) {

  if (parser.parseCustomAttributeWithFallback(messageAttr, parser.getBuilder().getType<::mlir::NoneType>())) {
    return ::mlir::failure();
  }
  if (messageAttr) result.getOrAddProperties<CoverConcurrentOp::Properties>().message = messageAttr;
  if (::mlir::succeeded(parser.parseOptionalLParen())) {

  substitutionsOperandsLoc = parser.getCurrentLocation();
  if (parser.parseOperandList(substitutionsOperands))
    return ::mlir::failure();
  if (parser.parseRParen())
    return ::mlir::failure();
  if (parser.parseColon())
    return ::mlir::failure();

  if (parser.parseTypeList(substitutionsTypes))
    return ::mlir::failure();
  }
  }
  {
    auto loc = parser.getCurrentLocation();(void)loc;
    if (parser.parseOptionalAttrDict(result.attributes))
      return ::mlir::failure();
    if (failed(verifyInherentAttrs(result.name, result.attributes, [&]() {
        return parser.emitError(loc) << "'" << result.name.getStringRef() << "' op ";
      })))
      return ::mlir::failure();
  }
  ::mlir::Type odsBuildableType0 = parser.getBuilder().getIntegerType(1);
  if (parser.resolveOperands(clockOperands, odsBuildableType0, clockOperandsLoc, result.operands))
    return ::mlir::failure();
  if (parser.resolveOperands(propertyOperands, odsBuildableType0, propertyOperandsLoc, result.operands))
    return ::mlir::failure();
  if (parser.resolveOperands(substitutionsOperands, substitutionsTypes, substitutionsOperandsLoc, result.operands))
    return ::mlir::failure();
  return ::mlir::success();
}

void CoverConcurrentOp::print(::mlir::OpAsmPrinter &_odsPrinter) {
  _odsPrinter << ' ';

  {
    auto caseValue = getEvent();
    auto caseValueStr = stringifyEventControl(caseValue);
    _odsPrinter << caseValueStr;
  }
  _odsPrinter << ' ';
  _odsPrinter << getClock();
  _odsPrinter << ",";
  _odsPrinter << ' ';
  _odsPrinter << getProperty();
  if (getLabelAttr()) {
    _odsPrinter << ' ' << "label";
    _odsPrinter << ' ';
    _odsPrinter.printAttributeWithoutType(getLabelAttr());
  }
  if (getMessageAttr()) {
    _odsPrinter << ' ' << "message";
    _odsPrinter << ' ';
    _odsPrinter.printAttributeWithoutType(getMessageAttr());
    if (!getSubstitutions().empty()) {
      _odsPrinter << "(";
      _odsPrinter << getSubstitutions();
      _odsPrinter << ")";
      _odsPrinter << ' ' << ":";
      _odsPrinter << ' ';
      _odsPrinter << getSubstitutions().getTypes();
    }
  }
  ::llvm::SmallVector<::llvm::StringRef, 2> elidedAttrs;
  elidedAttrs.push_back("event");
  elidedAttrs.push_back("label");
  elidedAttrs.push_back("message");
  _odsPrinter.printOptionalAttrDict((*this)->getAttrs(), elidedAttrs);
}


