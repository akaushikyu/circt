  std::unique_ptr<::mlir::Region> resetBlkRegion = std::make_unique<::mlir::Region>();
  if (parser.parseLParen())
    return ::mlir::failure();

  {
    ::llvm::StringRef attrStr;
    ::mlir::NamedAttrList attrStorage;
    auto loc = parser.getCurrentLocation();
    if (parser.parseOptionalKeyword(&attrStr, {"posedge","negedge","edge"})) {
      ::mlir::StringAttr attrVal;
      ::mlir::OptionalParseResult parseResult =
        parser.parseOptionalAttribute(attrVal,
                                      parser.getBuilder().getNoneType(),
                                      "clockEdge", attrStorage);
      if (parseResult.has_value()) {
        if (failed(*parseResult))
          return ::mlir::failure();
        attrStr = attrVal.getValue();
      } else {
        return parser.emitError(loc, "expected string or keyword containing one of the following enum values for attribute 'clockEdge' [posedge, negedge, edge]");
      }
    }
    if (!attrStr.empty()) {
      auto attrOptional = circt::sv::symbolizeEventControl(attrStr);
      if (!attrOptional)
        return parser.emitError(loc, "invalid ")
               << "clockEdge attribute specification: \"" << attrStr << '"';;

      clockEdgeAttr = circt::sv::EventControlAttr::get(parser.getBuilder().getContext(), *attrOptional);
        result.getOrAddProperties<AlwaysFFOp::Properties>().clockEdge = clockEdgeAttr;
    }
  }

  clockOperandsLoc = parser.getCurrentLocation();
  if (parser.parseOperand(clockRawOperand))
    return ::mlir::failure();
  if (parser.parseRParen())
    return ::mlir::failure();

  if (parser.parseRegion(*bodyBlkRegion))
    return ::mlir::failure();

  if (bodyBlkRegion->empty()) bodyBlkRegion->emplaceBlock();
  if (::mlir::succeeded(parser.parseOptionalLParen())) {

  {
    ::llvm::StringRef attrStr;
    ::mlir::NamedAttrList attrStorage;
    auto loc = parser.getCurrentLocation();
    if (parser.parseOptionalKeyword(&attrStr, {"noreset","syncreset","asyncreset"})) {
      ::mlir::StringAttr attrVal;
      ::mlir::OptionalParseResult parseResult =
        parser.parseOptionalAttribute(attrVal,
                                      parser.getBuilder().getNoneType(),
                                      "resetStyle", attrStorage);
      if (parseResult.has_value()) {
        if (failed(*parseResult))
          return ::mlir::failure();
        attrStr = attrVal.getValue();
      } else {
        return parser.emitError(loc, "expected string or keyword containing one of the following enum values for attribute 'resetStyle' [noreset, syncreset, asyncreset]");
      }
    }
    if (!attrStr.empty()) {
      auto attrOptional = ::circt::sv::symbolizeResetType(attrStr);
      if (!attrOptional)
        return parser.emitError(loc, "invalid ")
               << "resetStyle attribute specification: \"" << attrStr << '"';;

      resetStyleAttr = ::circt::sv::ResetTypeAttr::get(parser.getBuilder().getContext(), *attrOptional);
        result.getOrAddProperties<AlwaysFFOp::Properties>().resetStyle = resetStyleAttr;
    }
  }
  if (parser.parseColon())
    return ::mlir::failure();

  {
    ::llvm::StringRef attrStr;
    ::mlir::NamedAttrList attrStorage;
    auto loc = parser.getCurrentLocation();
    if (parser.parseOptionalKeyword(&attrStr, {"posedge","negedge","edge"})) {
      ::mlir::StringAttr attrVal;
      ::mlir::OptionalParseResult parseResult =
        parser.parseOptionalAttribute(attrVal,
                                      parser.getBuilder().getNoneType(),
                                      "resetEdge", attrStorage);
      if (parseResult.has_value()) {
