::llvm::LogicalResult GenerateForOpAdaptor::verify(::mlir::Location loc) {
  auto tblgen_genBlockName = getProperties().genBlockName; (void)tblgen_genBlockName;
  if (!tblgen_genBlockName) return emitError(loc, "'sv.generate.for' op requires attribute 'genBlockName'");
  auto tblgen_inductionVarName = getProperties().inductionVarName; (void)tblgen_inductionVarName;
  auto tblgen_lowerBound = getProperties().lowerBound; (void)tblgen_lowerBound;
  if (!tblgen_lowerBound) return emitError(loc, "'sv.generate.for' op requires attribute 'lowerBound'");
  auto tblgen_step = getProperties().step; (void)tblgen_step;
  if (!tblgen_step) return emitError(loc, "'sv.generate.for' op requires attribute 'step'");
  auto tblgen_upperBound = getProperties().upperBound; (void)tblgen_upperBound;
  if (!tblgen_upperBound) return emitError(loc, "'sv.generate.for' op requires attribute 'upperBound'");

  if (tblgen_lowerBound && !((::llvm::isa<::mlir::TypedAttr>(tblgen_lowerBound))))
    return emitError(loc, "'sv.generate.for' op attribute 'lowerBound' failed to satisfy constraint: TypedAttr instance");

  if (tblgen_upperBound && !((::llvm::isa<::mlir::TypedAttr>(tblgen_upperBound))))
    return emitError(loc, "'sv.generate.for' op attribute 'upperBound' failed to satisfy constraint: TypedAttr instance");

  if (tblgen_step && !((::llvm::isa<::mlir::TypedAttr>(tblgen_step))))
    return emitError(loc, "'sv.generate.for' op attribute 'step' failed to satisfy constraint: TypedAttr instance");

  if (tblgen_genBlockName && !((::llvm::isa<::mlir::StringAttr>(tblgen_genBlockName))))
    return emitError(loc, "'sv.generate.for' op attribute 'genBlockName' failed to satisfy constraint: string attribute");

  if (tblgen_inductionVarName && !((::llvm::isa<::mlir::StringAttr>(tblgen_inductionVarName))))
    return emitError(loc, "'sv.generate.for' op attribute 'inductionVarName' failed to satisfy constraint: string attribute");
