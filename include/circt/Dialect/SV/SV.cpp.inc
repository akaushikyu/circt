::llvm::LogicalResult AlwaysOp::verifyInvariantsImpl() {
  auto tblgen_events = getProperties().events; (void)tblgen_events;
  if (!tblgen_events) return emitOpError("requires attribute 'events'");

  if (::mlir::failed(__mlir_ods_local_attr_constraint_SV3(*this, tblgen_events, "events")))
    return ::mlir::failure();
  {
    unsigned index = 0; (void)index;
    auto valueGroup0 = getODSOperands(0);

    for (auto v : valueGroup0) {
      if (::mlir::failed(__mlir_ods_local_type_constraint_SV3(*this, v.getType(), "operand", index++)))
        return ::mlir::failure();
    }
  }
  {
    unsigned index = 0; (void)index;

    for (auto &region : ::llvm::MutableArrayRef((*this)->getRegion(0)))
      if (::mlir::failed(__mlir_ods_local_region_constraint_SV1(*this, region, "body", index++)))
        return ::mlir::failure();
  }
