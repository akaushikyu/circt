::llvm::LogicalResult FuncDPIImportOp::verifyInvariantsImpl() {
  auto tblgen_callee = getProperties().callee; (void)tblgen_callee;
  if (!tblgen_callee) return emitOpError("requires attribute 'callee'");
  auto tblgen_linkage_name = getProperties().linkage_name; (void)tblgen_linkage_name;

  if (::mlir::failed(__mlir_ods_local_attr_constraint_SV6(*this, tblgen_callee, "callee")))
    return ::mlir::failure();

  if (::mlir::failed(__mlir_ods_local_attr_constraint_SV4(*this, tblgen_linkage_name, "linkage_name")))
    return ::mlir::failure();
  return ::mlir::success();
}

::llvm::LogicalResult FuncDPIImportOp::verifyInvariants() {
  return verifyInvariantsImpl();
}

::mlir::ParseResult FuncDPIImportOp::parse(::mlir::OpAsmParser &parser, ::mlir::OperationState &result) {
  ::mlir::StringAttr linkage_nameAttr;
  ::mlir::FlatSymbolRefAttr calleeAttr;
  if (::mlir::succeeded(parser.parseOptionalKeyword("linkage"))) {

  if (parser.parseCustomAttributeWithFallback(linkage_nameAttr, parser.getBuilder().getType<::mlir::NoneType>())) {
    return ::mlir::failure();
  }
  if (linkage_nameAttr) result.getOrAddProperties<FuncDPIImportOp::Properties>().linkage_name = linkage_nameAttr;
  }

  if (parser.parseCustomAttributeWithFallback(calleeAttr, parser.getBuilder().getType<::mlir::NoneType>())) {
    return ::mlir::failure();
  }
  if (calleeAttr) result.getOrAddProperties<FuncDPIImportOp::Properties>().callee = calleeAttr;
  {
    auto loc = parser.getCurrentLocation();(void)loc;
    if (parser.parseOptionalAttrDict(result.attributes))
      return ::mlir::failure();
    if (failed(verifyInherentAttrs(result.name, result.attributes, [&]() {
        return parser.emitError(loc) << "'" << result.name.getStringRef() << "' op ";
      })))
      return ::mlir::failure();
  }
  return ::mlir::success();
}

void FuncDPIImportOp::print(::mlir::OpAsmPrinter &_odsPrinter) {
  if (getLinkageNameAttr()) {
    _odsPrinter << ' ' << "linkage";
    _odsPrinter << ' ';
    _odsPrinter.printAttributeWithoutType(getLinkageNameAttr());
  }
  _odsPrinter << ' ';
  _odsPrinter.printAttributeWithoutType(getCalleeAttr());
  ::llvm::SmallVector<::llvm::StringRef, 2> elidedAttrs;
  elidedAttrs.push_back("linkage_name");
  elidedAttrs.push_back("callee");
  _odsPrinter.printOptionalAttrDict((*this)->getAttrs(), elidedAttrs);
}


