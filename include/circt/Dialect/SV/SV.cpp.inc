void AlwaysFFOp::print(::mlir::OpAsmPrinter &_odsPrinter) {
  _odsPrinter << "(";

  {
    auto caseValue = getClockEdge();
    auto caseValueStr = stringifyEventControl(caseValue);
    _odsPrinter << caseValueStr;
  }
  _odsPrinter << ' ';
  _odsPrinter << getClock();
  _odsPrinter << ")";
  _odsPrinter << ' ';
  _odsPrinter.printRegion(getBodyBlk());
  if (getResetEdgeAttr()) {
    _odsPrinter << "(";

    {
      auto caseValue = getResetStyle();
      auto caseValueStr = stringifyResetType(caseValue);
      _odsPrinter << caseValueStr;
    }
    _odsPrinter << ' ' << ":";
    _odsPrinter << ' ';

    {
      auto caseValue = *getResetEdge();
      auto caseValueStr = stringifyEventControl(caseValue);
      _odsPrinter << caseValueStr;
    }
    _odsPrinter << ' ';
    if (::mlir::Value value = getReset())
      _odsPrinter << value;
    _odsPrinter << ")";
    _odsPrinter << ' ';
    _odsPrinter.printRegion(getResetBlk());
  }
  ::llvm::SmallVector<::llvm::StringRef, 2> elidedAttrs;
  elidedAttrs.push_back("clockEdge");
  elidedAttrs.push_back("resetStyle");
  elidedAttrs.push_back("resetEdge");
  {
     ::mlir::Builder odsBuilder(getContext());
     ::mlir::Attribute attr = getResetStyleAttr();
     if(attr && (attr == ::circt::sv::ResetTypeAttr::get(odsBuilder.getContext(), ResetType::NoReset)))
       elidedAttrs.push_back("resetStyle");
  }
  _odsPrinter.printOptionalAttrDict((*this)->getAttrs(), elidedAttrs);
}


