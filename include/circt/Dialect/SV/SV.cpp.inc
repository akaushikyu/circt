::llvm::LogicalResult CoverOp::verifyInvariantsImpl() {
  auto tblgen_defer = getProperties().defer; (void)tblgen_defer;
  if (!tblgen_defer) return emitOpError("requires attribute 'defer'");
  auto tblgen_label = getProperties().label; (void)tblgen_label;
  auto tblgen_message = getProperties().message; (void)tblgen_message;

  if (::mlir::failed(__mlir_ods_local_attr_constraint_SV5(*this, tblgen_defer, "defer")))
    return ::mlir::failure();

  if (::mlir::failed(__mlir_ods_local_attr_constraint_SV4(*this, tblgen_label, "label")))
    return ::mlir::failure();

  if (::mlir::failed(__mlir_ods_local_attr_constraint_SV4(*this, tblgen_message, "message")))
    return ::mlir::failure();
  {
    unsigned index = 0; (void)index;
    auto valueGroup0 = getODSOperands(0);

    for (auto v : valueGroup0) {
      if (::mlir::failed(__mlir_ods_local_type_constraint_SV2(*this, v.getType(), "operand", index++)))
        return ::mlir::failure();
    }
    auto valueGroup1 = getODSOperands(1);

    for (auto v : valueGroup1) {
      if (::mlir::failed(__mlir_ods_local_type_constraint_SV7(*this, v.getType(), "operand", index++)))
        return ::mlir::failure();
    }
  }
  if (!(((getMessage() && !getMessage()->empty()) || this->getODSOperands(1).empty())))
    return emitOpError("failed to verify that has message if has substitutions");
  if (!((!getMessage() && this->getODSOperands(1).empty())))
    return emitOpError("failed to verify that has no message");
  return ::mlir::success();
}

::llvm::LogicalResult CoverOp::verifyInvariants() {
  return verifyInvariantsImpl();
}

::mlir::ParseResult CoverOp::parse(::mlir::OpAsmParser &parser, ::mlir::OperationState &result) {
  ::mlir::OpAsmParser::UnresolvedOperand expressionRawOperand{};
  ::llvm::ArrayRef<::mlir::OpAsmParser::UnresolvedOperand> expressionOperands(&expressionRawOperand, 1);  ::llvm::SMLoc expressionOperandsLoc;
  (void)expressionOperandsLoc;
  circt::sv::DeferAssertAttr deferAttr;
  ::mlir::StringAttr labelAttr;
  ::mlir::StringAttr messageAttr;
  ::llvm::SmallVector<::mlir::OpAsmParser::UnresolvedOperand, 4> substitutionsOperands;
  ::llvm::SMLoc substitutionsOperandsLoc;
  (void)substitutionsOperandsLoc;
  ::llvm::SmallVector<::mlir::Type, 1> substitutionsTypes;

  expressionOperandsLoc = parser.getCurrentLocation();
  if (parser.parseOperand(expressionRawOperand))
    return ::mlir::failure();
  if (parser.parseComma())
    return ::mlir::failure();

  {
    ::llvm::StringRef attrStr;
    ::mlir::NamedAttrList attrStorage;
    auto loc = parser.getCurrentLocation();
    if (parser.parseOptionalKeyword(&attrStr, {"immediate","observed","final"})) {
      ::mlir::StringAttr attrVal;
      ::mlir::OptionalParseResult parseResult =
        parser.parseOptionalAttribute(attrVal,
                                      parser.getBuilder().getNoneType(),
                                      "defer", attrStorage);
      if (parseResult.has_value()) {
        if (failed(*parseResult))
          return ::mlir::failure();
        attrStr = attrVal.getValue();
      } else {
        return parser.emitError(loc, "expected string or keyword containing one of the following enum values for attribute 'defer' [immediate, observed, final]");
      }
    }
    if (!attrStr.empty()) {
      auto attrOptional = circt::sv::symbolizeDeferAssert(attrStr);
      if (!attrOptional)
        return parser.emitError(loc, "invalid ")
               << "defer attribute specification: \"" << attrStr << '"';;

      deferAttr = circt::sv::DeferAssertAttr::get(parser.getBuilder().getContext(), *attrOptional);
        result.getOrAddProperties<CoverOp::Properties>().defer = deferAttr;
    }
  }
  if (::mlir::succeeded(parser.parseOptionalKeyword("label"))) {

  if (parser.parseCustomAttributeWithFallback(labelAttr, parser.getBuilder().getType<::mlir::NoneType>())) {
    return ::mlir::failure();
  }
  if (labelAttr) result.getOrAddProperties<CoverOp::Properties>().label = labelAttr;
  }
  if (::mlir::succeeded(parser.parseOptionalKeyword("message"))) {

  if (parser.parseCustomAttributeWithFallback(messageAttr, parser.getBuilder().getType<::mlir::NoneType>())) {
    return ::mlir::failure();
  }
  if (messageAttr) result.getOrAddProperties<CoverOp::Properties>().message = messageAttr;
  if (::mlir::succeeded(parser.parseOptionalLParen())) {

  substitutionsOperandsLoc = parser.getCurrentLocation();
  if (parser.parseOperandList(substitutionsOperands))
    return ::mlir::failure();
  if (parser.parseRParen())
    return ::mlir::failure();
  if (parser.parseColon())
    return ::mlir::failure();

  if (parser.parseTypeList(substitutionsTypes))
    return ::mlir::failure();
  }
  }
  {
    auto loc = parser.getCurrentLocation();(void)loc;
    if (parser.parseOptionalAttrDict(result.attributes))
      return ::mlir::failure();
    if (failed(verifyInherentAttrs(result.name, result.attributes, [&]() {
        return parser.emitError(loc) << "'" << result.name.getStringRef() << "' op ";
      })))
      return ::mlir::failure();
  }
  ::mlir::Type odsBuildableType0 = parser.getBuilder().getIntegerType(1);
  if (parser.resolveOperands(expressionOperands, odsBuildableType0, expressionOperandsLoc, result.operands))
    return ::mlir::failure();
  if (parser.resolveOperands(substitutionsOperands, substitutionsTypes, substitutionsOperandsLoc, result.operands))
    return ::mlir::failure();
  return ::mlir::success();
}

void CoverOp::print(::mlir::OpAsmPrinter &_odsPrinter) {
  _odsPrinter << ' ';
  _odsPrinter << getExpression();
  _odsPrinter << ",";
  _odsPrinter << ' ';

  {
    auto caseValue = getDefer();
    auto caseValueStr = stringifyDeferAssert(caseValue);
    _odsPrinter << caseValueStr;
  }
  if (getLabelAttr()) {
    _odsPrinter << ' ' << "label";
    _odsPrinter << ' ';
    _odsPrinter.printAttributeWithoutType(getLabelAttr());
  }
  if (getMessageAttr()) {
    _odsPrinter << ' ' << "message";
    _odsPrinter << ' ';
    _odsPrinter.printAttributeWithoutType(getMessageAttr());
    if (!getSubstitutions().empty()) {
      _odsPrinter << "(";
      _odsPrinter << getSubstitutions();
      _odsPrinter << ")";
      _odsPrinter << ' ' << ":";
      _odsPrinter << ' ';
      _odsPrinter << getSubstitutions().getTypes();
    }
  }
  ::llvm::SmallVector<::llvm::StringRef, 2> elidedAttrs;
  elidedAttrs.push_back("defer");
  elidedAttrs.push_back("label");
  elidedAttrs.push_back("message");
  _odsPrinter.printOptionalAttrDict((*this)->getAttrs(), elidedAttrs);
}


