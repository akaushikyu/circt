::llvm::LogicalResult FatalOp::verifyInherentAttrs(::mlir::OperationName opName, ::mlir::NamedAttrList &attrs, llvm::function_ref<::mlir::InFlightDiagnostic()> emitError) {
    {
      ::mlir::Attribute attr = attrs.get(getMessageAttrName(opName));
      if (attr && ::mlir::failed(__mlir_ods_local_attr_constraint_SV4(attr, "message", emitError)))
        return ::mlir::failure();
    }

    {
      ::mlir::Attribute attr = attrs.get(getVerbosityAttrName(opName));
      if (attr && ::mlir::failed(__mlir_ods_local_attr_constraint_SV11(attr, "verbosity", emitError)))
        return ::mlir::failure();
    }
    return ::mlir::success();
}

