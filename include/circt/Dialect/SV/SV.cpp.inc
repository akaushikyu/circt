::llvm::LogicalResult InterfaceModportOpAdaptor::verify(::mlir::Location loc) {
  auto tblgen_ports = getProperties().ports; (void)tblgen_ports;
  if (!tblgen_ports) return emitError(loc, "'sv.interface.modport' op requires attribute 'ports'");
  auto tblgen_sym_name = getProperties().sym_name; (void)tblgen_sym_name;
  if (!tblgen_sym_name) return emitError(loc, "'sv.interface.modport' op requires attribute 'sym_name'");

  if (tblgen_sym_name && !((::llvm::isa<::mlir::StringAttr>(tblgen_sym_name))))
    return emitError(loc, "'sv.interface.modport' op attribute 'sym_name' failed to satisfy constraint: string attribute");

  if (tblgen_ports && !(((::llvm::isa<::mlir::ArrayAttr>(tblgen_ports))) && (::llvm::all_of(::llvm::cast<::mlir::ArrayAttr>(tblgen_ports), [&](::mlir::Attribute attr) { return attr && ((::llvm::isa<::circt::sv::ModportStructAttr>(attr))); }))))
    return emitError(loc, "'sv.interface.modport' op attribute 'ports' failed to satisfy constraint: array of modport structs");
  return ::mlir::success();
}

::llvm::LogicalResult InterfaceModportOp::setPropertiesFromAttr(Properties &prop, ::mlir::Attribute attr, ::llvm::function_ref<::mlir::InFlightDiagnostic()> emitError) {
  ::mlir::DictionaryAttr dict = ::llvm::dyn_cast<::mlir::DictionaryAttr>(attr);
  if (!dict) {
    emitError() << "expected DictionaryAttr to set properties";
    return ::mlir::failure();
  }

  {
    auto &propStorage = prop.ports;
       auto attr = dict.get("ports");
    if (attr) {
      auto convertedAttr = ::llvm::dyn_cast<std::remove_reference_t<decltype(propStorage)>>(attr);
      if (convertedAttr) {
        propStorage = convertedAttr;
      } else {
        emitError() << "Invalid attribute `ports` in property conversion: " << attr;
        return ::mlir::failure();
      }
    }
  }

  {
    auto &propStorage = prop.sym_name;
       auto attr = dict.get("sym_name");
    if (attr) {
      auto convertedAttr = ::llvm::dyn_cast<std::remove_reference_t<decltype(propStorage)>>(attr);
      if (convertedAttr) {
        propStorage = convertedAttr;
      } else {
        emitError() << "Invalid attribute `sym_name` in property conversion: " << attr;
        return ::mlir::failure();
      }
    }
  }
  return ::mlir::success();
}

::mlir::Attribute InterfaceModportOp::getPropertiesAsAttr(::mlir::MLIRContext *ctx, const Properties &prop) {
    ::mlir::SmallVector<::mlir::NamedAttribute> attrs;
    ::mlir::Builder odsBuilder{ctx};

    {
      const auto &propStorage = prop.ports;
      if (propStorage)
        attrs.push_back(odsBuilder.getNamedAttr("ports",
                                       propStorage));
    }

    {
      const auto &propStorage = prop.sym_name;
      if (propStorage)
        attrs.push_back(odsBuilder.getNamedAttr("sym_name",
                                       propStorage));
    }

  if (!attrs.empty())
    return odsBuilder.getDictionaryAttr(attrs);
  return {};
}

