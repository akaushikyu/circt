::llvm::LogicalResult GenerateForOp::verifyInvariantsImpl() {
  auto tblgen_genBlockName = getProperties().genBlockName; (void)tblgen_genBlockName;
  if (!tblgen_genBlockName) return emitOpError("requires attribute 'genBlockName'");
  auto tblgen_inductionVarName = getProperties().inductionVarName; (void)tblgen_inductionVarName;
  auto tblgen_lowerBound = getProperties().lowerBound; (void)tblgen_lowerBound;
  if (!tblgen_lowerBound) return emitOpError("requires attribute 'lowerBound'");
  auto tblgen_step = getProperties().step; (void)tblgen_step;
  if (!tblgen_step) return emitOpError("requires attribute 'step'");
  auto tblgen_upperBound = getProperties().upperBound; (void)tblgen_upperBound;
  if (!tblgen_upperBound) return emitOpError("requires attribute 'upperBound'");

  if (::mlir::failed(__mlir_ods_local_attr_constraint_SV15(*this, tblgen_lowerBound, "lowerBound")))
    return ::mlir::failure();

  if (::mlir::failed(__mlir_ods_local_attr_constraint_SV15(*this, tblgen_upperBound, "upperBound")))
    return ::mlir::failure();

  if (::mlir::failed(__mlir_ods_local_attr_constraint_SV15(*this, tblgen_step, "step")))
    return ::mlir::failure();

  if (::mlir::failed(__mlir_ods_local_attr_constraint_SV4(*this, tblgen_genBlockName, "genBlockName")))
    return ::mlir::failure();

  if (::mlir::failed(__mlir_ods_local_attr_constraint_SV4(*this, tblgen_inductionVarName, "inductionVarName")))
    return ::mlir::failure();
  if (!(((getLowerBound().getType()) == (getUpperBound().getType()) && (getUpperBound().getType()) == (getStep().getType()) && (getStep().getType()) == (getLowerBound().getType()))))
    return emitOpError("failed to verify that all of {lowerBound, upperBound, step} have same type");
  {
    unsigned index = 0; (void)index;

    for (auto &region : ::llvm::MutableArrayRef((*this)->getRegion(0)))
      if (::mlir::failed(__mlir_ods_local_region_constraint_SV1(*this, region, "body", index++)))
        return ::mlir::failure();
  }
  return ::mlir::success();
}

::llvm::LogicalResult GenerateForOp::verifyInvariants() {
  if(::mlir::succeeded(verifyInvariantsImpl()) && ::mlir::succeeded(verify()))
    return ::mlir::success();
  return ::mlir::failure();
}

::mlir::ParseResult GenerateForOp::parse(::mlir::OpAsmParser &parser, ::mlir::OperationState &result) {
  ::mlir::TypedAttr lowerBoundAttr;
  ::mlir::TypedAttr upperBoundAttr;
  ::mlir::TypedAttr stepAttr;
  ::mlir::StringAttr inductionVarNameAttr;
  ::mlir::StringAttr genBlockNameAttr;
  std::unique_ptr<::mlir::Region> bodyRegion = std::make_unique<::mlir::Region>();
  {
    auto odsResult = parseGenerateFor(parser, lowerBoundAttr, upperBoundAttr, stepAttr, inductionVarNameAttr, genBlockNameAttr, *bodyRegion);
    if (odsResult) return ::mlir::failure();
    result.getOrAddProperties<GenerateForOp::Properties>().lowerBound = lowerBoundAttr;
    result.getOrAddProperties<GenerateForOp::Properties>().upperBound = upperBoundAttr;
    result.getOrAddProperties<GenerateForOp::Properties>().step = stepAttr;
    if (inductionVarNameAttr)
      result.getOrAddProperties<GenerateForOp::Properties>().inductionVarName = inductionVarNameAttr;
    result.getOrAddProperties<GenerateForOp::Properties>().genBlockName = genBlockNameAttr;
  }
  {
    auto loc = parser.getCurrentLocation();(void)loc;
    if (parser.parseOptionalAttrDict(result.attributes))
      return ::mlir::failure();
    if (failed(verifyInherentAttrs(result.name, result.attributes, [&]() {
        return parser.emitError(loc) << "'" << result.name.getStringRef() << "' op ";
      })))
      return ::mlir::failure();
  }
  result.addRegion(std::move(bodyRegion));
  return ::mlir::success();
}

void GenerateForOp::print(::mlir::OpAsmPrinter &_odsPrinter) {
  _odsPrinter << ' ';
  printGenerateFor(_odsPrinter, *this, getLowerBoundAttr(), getUpperBoundAttr(), getStepAttr(), getInductionVarNameAttr(), getGenBlockNameAttr(), getBody());
  ::llvm::SmallVector<::llvm::StringRef, 2> elidedAttrs;
  elidedAttrs.push_back("lowerBound");
  elidedAttrs.push_back("upperBound");
  elidedAttrs.push_back("step");
  elidedAttrs.push_back("inductionVarName");
  elidedAttrs.push_back("genBlockName");
  _odsPrinter.printOptionalAttrDict((*this)->getAttrs(), elidedAttrs);
}


