::mlir::Attribute FuncOp::getPropertiesAsAttr(::mlir::MLIRContext *ctx, const Properties &prop) {
    ::mlir::SmallVector<::mlir::NamedAttribute> attrs;
    ::mlir::Builder odsBuilder{ctx};

    {
      const auto &propStorage = prop.input_locs;
      if (propStorage)
        attrs.push_back(odsBuilder.getNamedAttr("input_locs",
                                       propStorage));
    }

    {
      const auto &propStorage = prop.module_type;
      if (propStorage)
        attrs.push_back(odsBuilder.getNamedAttr("module_type",
                                       propStorage));
    }

    {
      const auto &propStorage = prop.per_argument_attrs;
      if (propStorage)
        attrs.push_back(odsBuilder.getNamedAttr("per_argument_attrs",
                                       propStorage));
    }

    {
      const auto &propStorage = prop.result_locs;
      if (propStorage)
        attrs.push_back(odsBuilder.getNamedAttr("result_locs",
                                       propStorage));
    }

    {
      const auto &propStorage = prop.sym_name;
      if (propStorage)
        attrs.push_back(odsBuilder.getNamedAttr("sym_name",
                                       propStorage));
    }

    {
      const auto &propStorage = prop.verilogName;
      if (propStorage)
        attrs.push_back(odsBuilder.getNamedAttr("verilogName",
                                       propStorage));
    }

  if (!attrs.empty())
    return odsBuilder.getDictionaryAttr(attrs);
  return {};
}

llvm::hash_code FuncOp::computePropertiesHash(const Properties &prop) {
  using llvm::hash_value;
  return llvm::hash_combine(
    llvm::hash_value(prop.input_locs.getAsOpaquePointer()), 
    llvm::hash_value(prop.module_type.getAsOpaquePointer()), 
    llvm::hash_value(prop.per_argument_attrs.getAsOpaquePointer()), 
    llvm::hash_value(prop.result_locs.getAsOpaquePointer()), 
    llvm::hash_value(prop.sym_name.getAsOpaquePointer()), 
    llvm::hash_value(prop.verilogName.getAsOpaquePointer()));
}

