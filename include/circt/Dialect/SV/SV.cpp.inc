::mlir::ParseResult AlwaysOp::parse(::mlir::OpAsmParser &parser, ::mlir::OperationState &result) {
  ::mlir::ArrayAttr eventsAttr;
  ::llvm::SmallVector<::mlir::OpAsmParser::UnresolvedOperand, 4> clocksOperands;
  ::llvm::SMLoc clocksOperandsLoc;
  (void)clocksOperandsLoc;
  std::unique_ptr<::mlir::Region> bodyRegion = std::make_unique<::mlir::Region>();
  {
    clocksOperandsLoc = parser.getCurrentLocation();
    auto odsResult = parseEventList(parser, eventsAttr, clocksOperands);
    if (odsResult) return ::mlir::failure();
    result.getOrAddProperties<AlwaysOp::Properties>().events = eventsAttr;
  }

  if (parser.parseRegion(*bodyRegion))
    return ::mlir::failure();

  if (bodyRegion->empty()) bodyRegion->emplaceBlock();
  {
    auto loc = parser.getCurrentLocation();(void)loc;
    if (parser.parseOptionalAttrDict(result.attributes))
      return ::mlir::failure();
    if (failed(verifyInherentAttrs(result.name, result.attributes, [&]() {
        return parser.emitError(loc) << "'" << result.name.getStringRef() << "' op ";
      })))
      return ::mlir::failure();
  }
  result.addRegion(std::move(bodyRegion));
  ::mlir::Type odsBuildableType0 = parser.getBuilder().getIntegerType(1);
  if (parser.resolveOperands(clocksOperands, odsBuildableType0, clocksOperandsLoc, result.operands))
    return ::mlir::failure();
  return ::mlir::success();
}

void AlwaysOp::print(::mlir::OpAsmPrinter &_odsPrinter) {
  _odsPrinter << ' ';
  printEventList(_odsPrinter, *this, getEventsAttr(), getClocks());
  _odsPrinter << ' ';
  _odsPrinter.printRegion(getBody());
  ::llvm::SmallVector<::llvm::StringRef, 2> elidedAttrs;
  elidedAttrs.push_back("events");
  _odsPrinter.printOptionalAttrDict((*this)->getAttrs(), elidedAttrs);
}


