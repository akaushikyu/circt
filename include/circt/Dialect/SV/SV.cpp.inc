::llvm::LogicalResult XMROpAdaptor::verify(::mlir::Location loc) {
  auto tblgen_isRooted = getProperties().isRooted; (void)tblgen_isRooted;
  auto tblgen_path = getProperties().path; (void)tblgen_path;
  if (!tblgen_path) return emitError(loc, "'sv.xmr' op requires attribute 'path'");
  auto tblgen_terminal = getProperties().terminal; (void)tblgen_terminal;
  if (!tblgen_terminal) return emitError(loc, "'sv.xmr' op requires attribute 'terminal'");

  if (tblgen_isRooted && !((::llvm::isa<::mlir::UnitAttr>(tblgen_isRooted))))
    return emitError(loc, "'sv.xmr' op attribute 'isRooted' failed to satisfy constraint: unit attribute");

  if (tblgen_path && !(((::llvm::isa<::mlir::ArrayAttr>(tblgen_path))) && (::llvm::all_of(::llvm::cast<::mlir::ArrayAttr>(tblgen_path), [&](::mlir::Attribute attr) { return attr && ((::llvm::isa<::mlir::StringAttr>(attr))); }))))
    return emitError(loc, "'sv.xmr' op attribute 'path' failed to satisfy constraint: string array attribute");

  if (tblgen_terminal && !((::llvm::isa<::mlir::StringAttr>(tblgen_terminal))))
    return emitError(loc, "'sv.xmr' op attribute 'terminal' failed to satisfy constraint: string attribute");
  return ::mlir::success();
}

::llvm::LogicalResult XMROp::setPropertiesFromAttr(Properties &prop, ::mlir::Attribute attr, ::llvm::function_ref<::mlir::InFlightDiagnostic()> emitError) {
  ::mlir::DictionaryAttr dict = ::llvm::dyn_cast<::mlir::DictionaryAttr>(attr);
  if (!dict) {
    emitError() << "expected DictionaryAttr to set properties";
    return ::mlir::failure();
  }

  {
    auto &propStorage = prop.isRooted;
       auto attr = dict.get("isRooted");
    if (attr) {
      auto convertedAttr = ::llvm::dyn_cast<std::remove_reference_t<decltype(propStorage)>>(attr);
      if (convertedAttr) {
        propStorage = convertedAttr;
      } else {
        emitError() << "Invalid attribute `isRooted` in property conversion: " << attr;
        return ::mlir::failure();
      }
    }
  }

  {
    auto &propStorage = prop.path;
       auto attr = dict.get("path");
    if (attr) {
      auto convertedAttr = ::llvm::dyn_cast<std::remove_reference_t<decltype(propStorage)>>(attr);
      if (convertedAttr) {
        propStorage = convertedAttr;
      } else {
        emitError() << "Invalid attribute `path` in property conversion: " << attr;
        return ::mlir::failure();
      }
    }
  }

  {
    auto &propStorage = prop.terminal;
       auto attr = dict.get("terminal");
    if (attr) {
      auto convertedAttr = ::llvm::dyn_cast<std::remove_reference_t<decltype(propStorage)>>(attr);
      if (convertedAttr) {
        propStorage = convertedAttr;
      } else {
        emitError() << "Invalid attribute `terminal` in property conversion: " << attr;
        return ::mlir::failure();
      }
    }
  }
  return ::mlir::success();
}

::mlir::Attribute XMROp::getPropertiesAsAttr(::mlir::MLIRContext *ctx, const Properties &prop) {
    ::mlir::SmallVector<::mlir::NamedAttribute> attrs;
    ::mlir::Builder odsBuilder{ctx};

    {
      const auto &propStorage = prop.isRooted;
      if (propStorage)
        attrs.push_back(odsBuilder.getNamedAttr("isRooted",
                                       propStorage));
    }

    {
      const auto &propStorage = prop.path;
      if (propStorage)
        attrs.push_back(odsBuilder.getNamedAttr("path",
                                       propStorage));
    }

    {
      const auto &propStorage = prop.terminal;
      if (propStorage)
        attrs.push_back(odsBuilder.getNamedAttr("terminal",
                                       propStorage));
    }

  if (!attrs.empty())
    return odsBuilder.getDictionaryAttr(attrs);
  return {};
}

