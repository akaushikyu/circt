::llvm::LogicalResult MacroDefOpAdaptor::verify(::mlir::Location loc) {
  auto tblgen_format_string = getProperties().format_string; (void)tblgen_format_string;
  if (!tblgen_format_string) return emitError(loc, "'sv.macro.def' op requires attribute 'format_string'");
  auto tblgen_macroName = getProperties().macroName; (void)tblgen_macroName;
  if (!tblgen_macroName) return emitError(loc, "'sv.macro.def' op requires attribute 'macroName'");
  auto tblgen_symbols = getProperties().symbols; (void)tblgen_symbols;

  if (tblgen_macroName && !((::llvm::isa<::mlir::FlatSymbolRefAttr>(tblgen_macroName))))
    return emitError(loc, "'sv.macro.def' op attribute 'macroName' failed to satisfy constraint: flat symbol reference attribute");

  if (tblgen_format_string && !((::llvm::isa<::mlir::StringAttr>(tblgen_format_string))))
    return emitError(loc, "'sv.macro.def' op attribute 'format_string' failed to satisfy constraint: string attribute");

  if (tblgen_symbols && !(((::llvm::isa<::mlir::ArrayAttr>(tblgen_symbols))) && (::llvm::all_of(::llvm::cast<::mlir::ArrayAttr>(tblgen_symbols), [&](::mlir::Attribute attr) { return attr && ((llvm::isa<::mlir::FlatSymbolRefAttr, ::circt::hw::InnerRefAttr>(attr))); }))))
    return emitError(loc, "'sv.macro.def' op attribute 'symbols' failed to satisfy constraint: name reference array attribute");
  return ::mlir::success();
}

::llvm::LogicalResult MacroDefOp::setPropertiesFromAttr(Properties &prop, ::mlir::Attribute attr, ::llvm::function_ref<::mlir::InFlightDiagnostic()> emitError) {
  ::mlir::DictionaryAttr dict = ::llvm::dyn_cast<::mlir::DictionaryAttr>(attr);
  if (!dict) {
    emitError() << "expected DictionaryAttr to set properties";
    return ::mlir::failure();
  }

  {
    auto &propStorage = prop.format_string;
       auto attr = dict.get("format_string");
    if (attr) {
      auto convertedAttr = ::llvm::dyn_cast<std::remove_reference_t<decltype(propStorage)>>(attr);
      if (convertedAttr) {
        propStorage = convertedAttr;
      } else {
        emitError() << "Invalid attribute `format_string` in property conversion: " << attr;
        return ::mlir::failure();
      }
    }
  }

  {
    auto &propStorage = prop.macroName;
       auto attr = dict.get("macroName");
    if (attr) {
      auto convertedAttr = ::llvm::dyn_cast<std::remove_reference_t<decltype(propStorage)>>(attr);
      if (convertedAttr) {
        propStorage = convertedAttr;
      } else {
        emitError() << "Invalid attribute `macroName` in property conversion: " << attr;
        return ::mlir::failure();
      }
    }
  }

  {
    auto &propStorage = prop.symbols;
       auto attr = dict.get("symbols");
    if (attr) {
      auto convertedAttr = ::llvm::dyn_cast<std::remove_reference_t<decltype(propStorage)>>(attr);
      if (convertedAttr) {
        propStorage = convertedAttr;
      } else {
        emitError() << "Invalid attribute `symbols` in property conversion: " << attr;
        return ::mlir::failure();
      }
    }
  }
  return ::mlir::success();
}

::mlir::Attribute MacroDefOp::getPropertiesAsAttr(::mlir::MLIRContext *ctx, const Properties &prop) {
    ::mlir::SmallVector<::mlir::NamedAttribute> attrs;
    ::mlir::Builder odsBuilder{ctx};

    {
      const auto &propStorage = prop.format_string;
      if (propStorage)
        attrs.push_back(odsBuilder.getNamedAttr("format_string",
                                       propStorage));
    }

    {
      const auto &propStorage = prop.macroName;
      if (propStorage)
        attrs.push_back(odsBuilder.getNamedAttr("macroName",
                                       propStorage));
    }

    {
      const auto &propStorage = prop.symbols;
      if (propStorage)
        attrs.push_back(odsBuilder.getNamedAttr("symbols",
                                       propStorage));
    }

  if (!attrs.empty())
    return odsBuilder.getDictionaryAttr(attrs);
  return {};
}

llvm::hash_code MacroDefOp::computePropertiesHash(const Properties &prop) {
  using llvm::hash_value;
  return llvm::hash_combine(
    llvm::hash_value(prop.format_string.getAsOpaquePointer()), 
    llvm::hash_value(prop.macroName.getAsOpaquePointer()), 
    llvm::hash_value(prop.symbols.getAsOpaquePointer()));
}

std::optional<mlir::Attribute> MacroDefOp::getInherentAttr(::mlir::MLIRContext *ctx, const Properties &prop, llvm::StringRef name) {
    if (name == "format_string")
      return prop.format_string;

    if (name == "macroName")
      return prop.macroName;

    if (name == "symbols")
      return prop.symbols;
  return std::nullopt;
}

void MacroDefOp::setInherentAttr(Properties &prop, llvm::StringRef name, mlir::Attribute value) {
    if (name == "format_string") {
       prop.format_string = ::llvm::dyn_cast_or_null<std::remove_reference_t<decltype(prop.format_string)>>(value);
       return;
    }

    if (name == "macroName") {
       prop.macroName = ::llvm::dyn_cast_or_null<std::remove_reference_t<decltype(prop.macroName)>>(value);
       return;
    }

    if (name == "symbols") {
       prop.symbols = ::llvm::dyn_cast_or_null<std::remove_reference_t<decltype(prop.symbols)>>(value);
       return;
    }
}

void MacroDefOp::populateInherentAttrs(::mlir::MLIRContext *ctx, const Properties &prop, ::mlir::NamedAttrList &attrs) {
    if (prop.format_string) attrs.append("format_string", prop.format_string);

    if (prop.macroName) attrs.append("macroName", prop.macroName);

    if (prop.symbols) attrs.append("symbols", prop.symbols);
}

::llvm::LogicalResult MacroDefOp::verifyInherentAttrs(::mlir::OperationName opName, ::mlir::NamedAttrList &attrs, llvm::function_ref<::mlir::InFlightDiagnostic()> emitError) {
    {
      ::mlir::Attribute attr = attrs.get(getFormatStringAttrName(opName));
      if (attr && ::mlir::failed(__mlir_ods_local_attr_constraint_SV4(attr, "format_string", emitError)))
        return ::mlir::failure();
    }

    {
      ::mlir::Attribute attr = attrs.get(getMacroNameAttrName(opName));
      if (attr && ::mlir::failed(__mlir_ods_local_attr_constraint_SV6(attr, "macroName", emitError)))
        return ::mlir::failure();
    }

    {
      ::mlir::Attribute attr = attrs.get(getSymbolsAttrName(opName));
      if (attr && ::mlir::failed(__mlir_ods_local_attr_constraint_SV26(attr, "symbols", emitError)))
        return ::mlir::failure();
    }
    return ::mlir::success();
}

