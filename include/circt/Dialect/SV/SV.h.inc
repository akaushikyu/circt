class AssumeOpGenericAdaptorBase {
public:
  struct Properties {
    using deferTy = circt::sv::DeferAssertAttr;
    deferTy defer;

    auto getDefer() const {
      auto &propStorage = this->defer;
      return ::llvm::cast<circt::sv::DeferAssertAttr>(propStorage);
    }
    void setDefer(const circt::sv::DeferAssertAttr &propValue) {
      this->defer = propValue;
    }
    using labelTy = ::mlir::StringAttr;
    labelTy label;

    auto getLabel() const {
      auto &propStorage = this->label;
      return ::llvm::dyn_cast_or_null<::mlir::StringAttr>(propStorage);
    }
    void setLabel(const ::mlir::StringAttr &propValue) {
      this->label = propValue;
    }
    using messageTy = ::mlir::StringAttr;
    messageTy message;

    auto getMessage() const {
      auto &propStorage = this->message;
      return ::llvm::dyn_cast_or_null<::mlir::StringAttr>(propStorage);
    }
    void setMessage(const ::mlir::StringAttr &propValue) {
      this->message = propValue;
    }
    bool operator==(const Properties &rhs) const {
      return 
        rhs.defer == this->defer &&
        rhs.label == this->label &&
        rhs.message == this->message &&
        true;
    }
    bool operator!=(const Properties &rhs) const {
      return !(*this == rhs);
    }
  };
protected:
  ::mlir::DictionaryAttr odsAttrs;
  ::std::optional<::mlir::OperationName> odsOpName;
  Properties properties;
  ::mlir::RegionRange odsRegions;
public:
  AssumeOpGenericAdaptorBase(::mlir::DictionaryAttr attrs, const Properties &properties, ::mlir::RegionRange regions = {}) : odsAttrs(attrs), properties(properties), odsRegions(regions) {  if (odsAttrs)
      odsOpName.emplace("sv.assume", odsAttrs.getContext());
  }

  AssumeOpGenericAdaptorBase(AssumeOp op);

  std::pair<unsigned, unsigned> getODSOperandIndexAndLength(unsigned index, unsigned odsOperandsSize);
  const Properties &getProperties() {
    return properties;
  }

  ::mlir::DictionaryAttr getAttributes() {
    return odsAttrs;
  }

  circt::sv::DeferAssertAttr getDeferAttr() {
    auto attr = ::llvm::cast<circt::sv::DeferAssertAttr>(getProperties().defer);
    return attr;
  }

  circt::sv::DeferAssert getDefer();
  ::mlir::StringAttr getLabelAttr() {
    auto attr = ::llvm::dyn_cast_or_null<::mlir::StringAttr>(getProperties().label);
    return attr;
  }

  ::std::optional< ::llvm::StringRef > getLabel();
  ::mlir::StringAttr getMessageAttr() {
    auto attr = ::llvm::dyn_cast_or_null<::mlir::StringAttr>(getProperties().message);
    return attr;
  }

  ::std::optional< ::llvm::StringRef > getMessage();
};

