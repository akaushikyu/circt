::llvm::LogicalResult ConstantOp::verifyInvariantsImpl() {
  auto tblgen_rawValue = getProperties().rawValue; (void)tblgen_rawValue;
  if (!tblgen_rawValue) return emitOpError("requires attribute 'rawValue'");

  if (::mlir::failed(__mlir_ods_local_attr_constraint_HWArith1(*this, tblgen_rawValue, "rawValue")))
    return ::mlir::failure();
  {
    unsigned index = 0; (void)index;
    auto valueGroup0 = getODSResults(0);

    for (auto v : valueGroup0) {
      if (::mlir::failed(__mlir_ods_local_type_constraint_HWArith2(*this, v.getType(), "result", index++)))
        return ::mlir::failure();
    }
  }
  return ::mlir::success();
}

