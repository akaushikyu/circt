    isConcurrentTy isConcurrent;

    auto getIsConcurrent() const {
      auto &propStorage = this->isConcurrent;
      return ::llvm::dyn_cast_or_null<::mlir::BoolAttr>(propStorage);
    }
    void setIsConcurrent(const ::mlir::BoolAttr &propValue) {
      this->isConcurrent = propValue;
