::llvm::LogicalResult ShlPrimOpAdaptor::verify(::mlir::Location loc) {
  auto tblgen_amount = getProperties().amount; (void)tblgen_amount;
  if (!tblgen_amount) return emitError(loc, "'firrtl.shl' op requires attribute 'amount'");

  if (tblgen_amount && !(((::llvm::isa<::mlir::IntegerAttr>(tblgen_amount))) && ((::llvm::cast<::mlir::IntegerAttr>(tblgen_amount).getType().isSignlessInteger(32)))))
    return emitError(loc, "'firrtl.shl' op attribute 'amount' failed to satisfy constraint: 32-bit signless integer attribute");
  return ::mlir::success();
}

::llvm::LogicalResult ShlPrimOp::setPropertiesFromAttr(Properties &prop, ::mlir::Attribute attr, ::llvm::function_ref<::mlir::InFlightDiagnostic()> emitError) {
  ::mlir::DictionaryAttr dict = ::llvm::dyn_cast<::mlir::DictionaryAttr>(attr);
  if (!dict) {
    emitError() << "expected DictionaryAttr to set properties";
    return ::mlir::failure();
  }

  {
    auto &propStorage = prop.amount;
       auto attr = dict.get("amount");
    if (attr) {
      auto convertedAttr = ::llvm::dyn_cast<std::remove_reference_t<decltype(propStorage)>>(attr);
      if (convertedAttr) {
        propStorage = convertedAttr;
      } else {
        emitError() << "Invalid attribute `amount` in property conversion: " << attr;
        return ::mlir::failure();
      }
    }
  }
  return ::mlir::success();
}

::mlir::Attribute ShlPrimOp::getPropertiesAsAttr(::mlir::MLIRContext *ctx, const Properties &prop) {
    ::mlir::SmallVector<::mlir::NamedAttribute> attrs;
    ::mlir::Builder odsBuilder{ctx};

    {
      const auto &propStorage = prop.amount;
      if (propStorage)
        attrs.push_back(odsBuilder.getNamedAttr("amount",
                                       propStorage));
    }

  if (!attrs.empty())
    return odsBuilder.getDictionaryAttr(attrs);
  return {};
}

