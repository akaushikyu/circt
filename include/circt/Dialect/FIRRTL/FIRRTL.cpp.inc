      ::mlir::Attribute attr = attrs.get(getMessageAttrName(opName));
      if (attr && ::mlir::failed(__mlir_ods_local_attr_constraint_FIRRTL2(attr, "message", emitError)))
        return ::mlir::failure();
    }

    {
