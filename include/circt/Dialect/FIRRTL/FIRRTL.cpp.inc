  ::mlir::StringAttr verbatimSuffixAttr;
  ::mlir::Type destRawType{};
  ::llvm::ArrayRef<::mlir::Type> destTypes(&destRawType, 1);

  if (parser.parseCustomAttributeWithFallback(refAttr, parser.getBuilder().getType<::mlir::NoneType>())) {
    return ::mlir::failure();
