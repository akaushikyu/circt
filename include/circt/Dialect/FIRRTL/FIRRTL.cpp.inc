::llvm::LogicalResult FModuleOp::readProperties(::mlir::DialectBytecodeReader &reader, ::mlir::OperationState &state) {
  auto &prop = state.getOrAddProperties<Properties>(); (void)prop;
  if (::mlir::failed(reader.readOptionalAttribute(prop.annotations)))
    return ::mlir::failure();

  if (::mlir::failed(reader.readAttribute(prop.convention)))
    return ::mlir::failure();

  if (::mlir::failed(reader.readOptionalAttribute(prop.domainInfo)))
    return ::mlir::failure();

  if (::mlir::failed(reader.readOptionalAttribute(prop.layers)))
    return ::mlir::failure();

  if (::mlir::failed(reader.readAttribute(prop.portAnnotations)))
    return ::mlir::failure();

  if (::mlir::failed(reader.readAttribute(prop.portDirections)))
    return ::mlir::failure();

  if (::mlir::failed(reader.readAttribute(prop.portLocations)))
    return ::mlir::failure();

  if (::mlir::failed(reader.readAttribute(prop.portNames)))
    return ::mlir::failure();

  if (::mlir::failed(reader.readAttribute(prop.portSymbols)))
    return ::mlir::failure();

  if (::mlir::failed(reader.readAttribute(prop.portTypes)))
    return ::mlir::failure();

  if (::mlir::failed(reader.readAttribute(prop.sym_name)))
    return ::mlir::failure();
  return ::mlir::success();
}

void FModuleOp::writeProperties(::mlir::DialectBytecodeWriter &writer) {
  auto &prop = getProperties(); (void)prop;

  writer.writeOptionalAttribute(prop.annotations);
  writer.writeAttribute(prop.convention);

  writer.writeOptionalAttribute(prop.domainInfo);

  writer.writeOptionalAttribute(prop.layers);
  writer.writeAttribute(prop.portAnnotations);
  writer.writeAttribute(prop.portDirections);
  writer.writeAttribute(prop.portLocations);
  writer.writeAttribute(prop.portNames);
  writer.writeAttribute(prop.portSymbols);
  writer.writeAttribute(prop.portTypes);
  writer.writeAttribute(prop.sym_name);
}

