  odsState.addOperands(enable);
  odsState.addOperands(substitutions);
  odsState.getOrAddProperties<Properties>().message = message;
  odsState.getOrAddProperties<Properties>().name = name;
  if (isConcurrent) {
    odsState.getOrAddProperties<Properties>().isConcurrent = isConcurrent;
  }
  if (eventControl) {
    odsState.getOrAddProperties<Properties>().eventControl = eventControl;
