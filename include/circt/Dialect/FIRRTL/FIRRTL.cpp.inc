::llvm::LogicalResult VerbatimExprOpAdaptor::verify(::mlir::Location loc) {
  auto tblgen_symbols = getProperties().symbols; (void)tblgen_symbols;
  auto tblgen_text = getProperties().text; (void)tblgen_text;
  if (!tblgen_text) return emitError(loc, "'firrtl.verbatim.expr' op requires attribute 'text'");

  if (tblgen_text && !((::llvm::isa<::mlir::StringAttr>(tblgen_text))))
    return emitError(loc, "'firrtl.verbatim.expr' op attribute 'text' failed to satisfy constraint: string attribute");

  if (tblgen_symbols && !(((::llvm::isa<::mlir::ArrayAttr>(tblgen_symbols))) && (::llvm::all_of(::llvm::cast<::mlir::ArrayAttr>(tblgen_symbols), [&](::mlir::Attribute attr) { return attr && ((llvm::isa<::mlir::FlatSymbolRefAttr, ::circt::hw::InnerRefAttr>(attr))); }))))
    return emitError(loc, "'firrtl.verbatim.expr' op attribute 'symbols' failed to satisfy constraint: name reference array attribute");
  return ::mlir::success();
}

