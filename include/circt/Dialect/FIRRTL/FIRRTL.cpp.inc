  _odsPrinter.printOptionalAttrDict((*this)->getAttrs(), elidedAttrs);
  _odsPrinter << ' ' << ":";
  _odsPrinter << ' ';
  {
    auto type = getPredicate().getType();
    if (auto validType = ::llvm::dyn_cast<::circt::firrtl::UIntType>(type))
      _odsPrinter.printStrippedAttrOrType(validType);
   else
     _odsPrinter << type;
  }
  _odsPrinter << ",";
  _odsPrinter << ' ';
   _odsPrinter << getDest().getType();
  _odsPrinter << ",";
  _odsPrinter << ' ';
   _odsPrinter << getSrc().getType();
}


