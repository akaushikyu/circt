    ::mlir::NamedAttrList attrStorage;
    auto loc = parser.getCurrentLocation();
    if (parser.parseOptionalKeyword(&attrStr, {"dont_touch","instance","member_instance","member_reference","reference"})) {
      ::mlir::StringAttr attrVal;
