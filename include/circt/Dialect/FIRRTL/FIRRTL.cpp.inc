size_t FMemModuleOp::getNumPorts() {
  return getPortTypesAttr().size();
}

size_t FMemModuleOp::getNumInputPorts() {
  size_t count = 0;
  for (size_t i = 0, e = getNumPorts(); i < e; ++i)
    if (getPortDirection(i) == Direction::In)
      ++count;
  return count;
}

size_t FMemModuleOp::getNumOutputPorts() {
  size_t count = 0;
  for (size_t i = 0, e = getNumPorts(); i < e; ++i)
    if (getPortDirection(i) == Direction::Out)
      ++count;
  return count;
}

size_t FMemModuleOp::getPortIdForInputId(size_t idx) {
  for (size_t i = 0, e = getNumPorts(); i < e; ++i)
    if (getPortDirection(i) == Direction::In) {
      if (!idx)
        return i;
      --idx;
    }
  assert(0 && "Out of bounds input port id");
  return ~0ULL;
}

size_t FMemModuleOp::getPortIdForOutputId(size_t idx) {
  for (size_t i = 0, e = getNumPorts(); i < e; ++i)
    if (getPortDirection(i) == Direction::Out) {
      if (!idx)
        return i;
      --idx;
    }
  assert(0 && "Out of bounds input port id");
  return ~0ULL;
}

