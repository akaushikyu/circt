::llvm::LogicalResult GenericIntrinsicOp::setPropertiesFromAttr(Properties &prop, ::mlir::Attribute attr, ::llvm::function_ref<::mlir::InFlightDiagnostic()> emitError) {
  ::mlir::DictionaryAttr dict = ::llvm::dyn_cast<::mlir::DictionaryAttr>(attr);
  if (!dict) {
    emitError() << "expected DictionaryAttr to set properties";
    return ::mlir::failure();
  }

  {
    auto &propStorage = prop.intrinsic;
       auto attr = dict.get("intrinsic");
    if (attr) {
      auto convertedAttr = ::llvm::dyn_cast<std::remove_reference_t<decltype(propStorage)>>(attr);
      if (convertedAttr) {
        propStorage = convertedAttr;
      } else {
        emitError() << "Invalid attribute `intrinsic` in property conversion: " << attr;
        return ::mlir::failure();
      }
    }
  }

  {
    auto &propStorage = prop.parameters;
       auto attr = dict.get("parameters");
    if (attr) {
      auto convertedAttr = ::llvm::dyn_cast<std::remove_reference_t<decltype(propStorage)>>(attr);
      if (convertedAttr) {
        propStorage = convertedAttr;
      } else {
        emitError() << "Invalid attribute `parameters` in property conversion: " << attr;
        return ::mlir::failure();
      }
    }
  }
  return ::mlir::success();
}

::mlir::Attribute GenericIntrinsicOp::getPropertiesAsAttr(::mlir::MLIRContext *ctx, const Properties &prop) {
    ::mlir::SmallVector<::mlir::NamedAttribute> attrs;
    ::mlir::Builder odsBuilder{ctx};

    {
      const auto &propStorage = prop.intrinsic;
      if (propStorage)
        attrs.push_back(odsBuilder.getNamedAttr("intrinsic",
                                       propStorage));
    }

    {
      const auto &propStorage = prop.parameters;
      if (propStorage)
        attrs.push_back(odsBuilder.getNamedAttr("parameters",
                                       propStorage));
    }

  if (!attrs.empty())
    return odsBuilder.getDictionaryAttr(attrs);
  return {};
}

llvm::hash_code GenericIntrinsicOp::computePropertiesHash(const Properties &prop) {
  using llvm::hash_value;
  return llvm::hash_combine(
    llvm::hash_value(prop.intrinsic.getAsOpaquePointer()), 
    llvm::hash_value(prop.parameters.getAsOpaquePointer()));
}

std::optional<mlir::Attribute> GenericIntrinsicOp::getInherentAttr(::mlir::MLIRContext *ctx, const Properties &prop, llvm::StringRef name) {
    if (name == "intrinsic")
      return prop.intrinsic;

    if (name == "parameters")
      return prop.parameters;
  return std::nullopt;
}

void GenericIntrinsicOp::setInherentAttr(Properties &prop, llvm::StringRef name, mlir::Attribute value) {
    if (name == "intrinsic") {
       prop.intrinsic = ::llvm::dyn_cast_or_null<std::remove_reference_t<decltype(prop.intrinsic)>>(value);
       return;
    }

    if (name == "parameters") {
       prop.parameters = ::llvm::dyn_cast_or_null<std::remove_reference_t<decltype(prop.parameters)>>(value);
       return;
    }
}

void GenericIntrinsicOp::populateInherentAttrs(::mlir::MLIRContext *ctx, const Properties &prop, ::mlir::NamedAttrList &attrs) {
    if (prop.intrinsic) attrs.append("intrinsic", prop.intrinsic);

    if (prop.parameters) attrs.append("parameters", prop.parameters);
}

::llvm::LogicalResult GenericIntrinsicOp::verifyInherentAttrs(::mlir::OperationName opName, ::mlir::NamedAttrList &attrs, llvm::function_ref<::mlir::InFlightDiagnostic()> emitError) {
    {
      ::mlir::Attribute attr = attrs.get(getIntrinsicAttrName(opName));
      if (attr && ::mlir::failed(__mlir_ods_local_attr_constraint_FIRRTL2(attr, "intrinsic", emitError)))
        return ::mlir::failure();
    }

    {
      ::mlir::Attribute attr = attrs.get(getParametersAttrName(opName));
      if (attr && ::mlir::failed(__mlir_ods_local_attr_constraint_FIRRTL16(attr, "parameters", emitError)))
        return ::mlir::failure();
    }
    return ::mlir::success();
}

