void AssumeOp::build(::mlir::OpBuilder &odsBuilder, ::mlir::OperationState &odsState, ::mlir::Value clock, ::mlir::Value predicate, ::mlir::Value enable, ::mlir::StringAttr message, ::mlir::ValueRange substitutions, ::mlir::StringAttr name, ::mlir::BoolAttr isConcurrent, ::circt::firrtl::EventControlAttr eventControl) {
