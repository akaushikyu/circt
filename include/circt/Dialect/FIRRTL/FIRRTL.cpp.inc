size_t FExtModuleOp::getNumPorts() {
  return getPortTypesAttr().size();
}

size_t FExtModuleOp::getNumInputPorts() {
  size_t count = 0;
  for (size_t i = 0, e = getNumPorts(); i < e; ++i)
    if (getPortDirection(i) == Direction::In)
      ++count;
  return count;
}

size_t FExtModuleOp::getNumOutputPorts() {
  size_t count = 0;
  for (size_t i = 0, e = getNumPorts(); i < e; ++i)
    if (getPortDirection(i) == Direction::Out)
      ++count;
  return count;
}

size_t FExtModuleOp::getPortIdForInputId(size_t idx) {
  for (size_t i = 0, e = getNumPorts(); i < e; ++i)
    if (getPortDirection(i) == Direction::In) {
      if (!idx)
        return i;
      --idx;
    }
  assert(0 && "Out of bounds input port id");
  return ~0ULL;
}

size_t FExtModuleOp::getPortIdForOutputId(size_t idx) {
  for (size_t i = 0, e = getNumPorts(); i < e; ++i)
    if (getPortDirection(i) == Direction::Out) {
      if (!idx)
        return i;
      --idx;
    }
  assert(0 && "Out of bounds input port id");
  return ~0ULL;
}

