::llvm::LogicalResult OptionCaseOp::verifyInvariantsImpl() {
  auto tblgen_case_macro = getProperties().case_macro; (void)tblgen_case_macro;
  auto tblgen_sym_name = getProperties().sym_name; (void)tblgen_sym_name;
  if (!tblgen_sym_name) return emitOpError("requires attribute 'sym_name'");

  if (::mlir::failed(__mlir_ods_local_attr_constraint_FIRRTL2(*this, tblgen_sym_name, "sym_name")))
    return ::mlir::failure();

  if (::mlir::failed(__mlir_ods_local_attr_constraint_FIRRTL22(*this, tblgen_case_macro, "case_macro")))
    return ::mlir::failure();
  return ::mlir::success();
}

