::mlir::ParseResult LayerBlockOp::parse(::mlir::OpAsmParser &parser, ::mlir::OperationState &result) {
  ::mlir::SymbolRefAttr layerNameAttr;
  std::unique_ptr<::mlir::Region> regionRegion = std::make_unique<::mlir::Region>();

  if (parser.parseCustomAttributeWithFallback(layerNameAttr, parser.getBuilder().getType<::mlir::NoneType>())) {
    return ::mlir::failure();
