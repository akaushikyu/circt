        attrs.push_back(odsBuilder.getNamedAttr("instance_macro",
                                       propStorage));
    }

    {
      const auto &propStorage = prop.layers;
      if (propStorage)
        attrs.push_back(odsBuilder.getNamedAttr("layers",
                                       propStorage));
    }

    {
      const auto &propStorage = prop.moduleNames;
      if (propStorage)
        attrs.push_back(odsBuilder.getNamedAttr("moduleNames",
                                       propStorage));
    }

    {
