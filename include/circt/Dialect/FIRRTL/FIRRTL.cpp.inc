::llvm::LogicalResult PathOpAdaptor::verify(::mlir::Location loc) {
  auto tblgen_target = getProperties().target; (void)tblgen_target;
  if (!tblgen_target) return emitError(loc, "'firrtl.path' op requires attribute 'target'");
  auto tblgen_targetKind = getProperties().targetKind; (void)tblgen_targetKind;
  if (!tblgen_targetKind) return emitError(loc, "'firrtl.path' op requires attribute 'targetKind'");

  if (tblgen_targetKind && !((::llvm::isa<::circt::firrtl::TargetKindAttr>(tblgen_targetKind))))
    return emitError(loc, "'firrtl.path' op attribute 'targetKind' failed to satisfy constraint: object model target kind");

  if (tblgen_target && !((llvm::isa<::mlir::DistinctAttr>(tblgen_target))))
    return emitError(loc, "'firrtl.path' op attribute 'target' failed to satisfy constraint: distinct attribute");
  return ::mlir::success();
}

::llvm::LogicalResult PathOp::setPropertiesFromAttr(Properties &prop, ::mlir::Attribute attr, ::llvm::function_ref<::mlir::InFlightDiagnostic()> emitError) {
  ::mlir::DictionaryAttr dict = ::llvm::dyn_cast<::mlir::DictionaryAttr>(attr);
  if (!dict) {
    emitError() << "expected DictionaryAttr to set properties";
    return ::mlir::failure();
  }

  {
    auto &propStorage = prop.target;
       auto attr = dict.get("target");
    if (attr) {
      auto convertedAttr = ::llvm::dyn_cast<std::remove_reference_t<decltype(propStorage)>>(attr);
      if (convertedAttr) {
        propStorage = convertedAttr;
      } else {
        emitError() << "Invalid attribute `target` in property conversion: " << attr;
        return ::mlir::failure();
      }
    }
  }

  {
    auto &propStorage = prop.targetKind;
       auto attr = dict.get("targetKind");
    if (attr) {
      auto convertedAttr = ::llvm::dyn_cast<std::remove_reference_t<decltype(propStorage)>>(attr);
      if (convertedAttr) {
        propStorage = convertedAttr;
      } else {
        emitError() << "Invalid attribute `targetKind` in property conversion: " << attr;
        return ::mlir::failure();
      }
    }
  }
  return ::mlir::success();
}

::mlir::Attribute PathOp::getPropertiesAsAttr(::mlir::MLIRContext *ctx, const Properties &prop) {
    ::mlir::SmallVector<::mlir::NamedAttribute> attrs;
    ::mlir::Builder odsBuilder{ctx};

    {
      const auto &propStorage = prop.target;
      if (propStorage)
        attrs.push_back(odsBuilder.getNamedAttr("target",
                                       propStorage));
    }

    {
      const auto &propStorage = prop.targetKind;
      if (propStorage)
        attrs.push_back(odsBuilder.getNamedAttr("targetKind",
                                       propStorage));
    }

  if (!attrs.empty())
    return odsBuilder.getDictionaryAttr(attrs);
  return {};
}

llvm::hash_code PathOp::computePropertiesHash(const Properties &prop) {
  using llvm::hash_value;
  return llvm::hash_combine(
    llvm::hash_value(prop.target.getAsOpaquePointer()), 
    llvm::hash_value(prop.targetKind.getAsOpaquePointer()));
}

std::optional<mlir::Attribute> PathOp::getInherentAttr(::mlir::MLIRContext *ctx, const Properties &prop, llvm::StringRef name) {
    if (name == "target")
      return prop.target;

    if (name == "targetKind")
      return prop.targetKind;
  return std::nullopt;
}

void PathOp::setInherentAttr(Properties &prop, llvm::StringRef name, mlir::Attribute value) {
    if (name == "target") {
       prop.target = ::llvm::dyn_cast_or_null<std::remove_reference_t<decltype(prop.target)>>(value);
       return;
    }

    if (name == "targetKind") {
       prop.targetKind = ::llvm::dyn_cast_or_null<std::remove_reference_t<decltype(prop.targetKind)>>(value);
       return;
    }
}

void PathOp::populateInherentAttrs(::mlir::MLIRContext *ctx, const Properties &prop, ::mlir::NamedAttrList &attrs) {
    if (prop.target) attrs.append("target", prop.target);

    if (prop.targetKind) attrs.append("targetKind", prop.targetKind);
}

::llvm::LogicalResult PathOp::verifyInherentAttrs(::mlir::OperationName opName, ::mlir::NamedAttrList &attrs, llvm::function_ref<::mlir::InFlightDiagnostic()> emitError) {
    {
      ::mlir::Attribute attr = attrs.get(getTargetAttrName(opName));
      if (attr && ::mlir::failed(__mlir_ods_local_attr_constraint_FIRRTL38(attr, "target", emitError)))
        return ::mlir::failure();
    }

    {
      ::mlir::Attribute attr = attrs.get(getTargetKindAttrName(opName));
      if (attr && ::mlir::failed(__mlir_ods_local_attr_constraint_FIRRTL37(attr, "targetKind", emitError)))
        return ::mlir::failure();
    }
    return ::mlir::success();
}

::llvm::LogicalResult PathOp::readProperties(::mlir::DialectBytecodeReader &reader, ::mlir::OperationState &state) {
