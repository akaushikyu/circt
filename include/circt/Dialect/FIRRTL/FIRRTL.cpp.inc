FIntModuleOp FIntModuleOp::create(::mlir::OpBuilder &builder, ::mlir::Location location, StringAttr name, ArrayRef<PortInfo> ports, StringRef intrinsicNameStr, ArrayAttr annotations, ArrayAttr parameters, ArrayAttr layers) {
  ::mlir::OperationState __state__(location, getOperationName());
  build(builder, __state__, std::forward<decltype(name)>(name), std::forward<decltype(ports)>(ports), std::forward<decltype(intrinsicNameStr)>(intrinsicNameStr), std::forward<decltype(annotations)>(annotations), std::forward<decltype(parameters)>(parameters), std::forward<decltype(layers)>(layers));
  auto __res__ = ::llvm::dyn_cast<FIntModuleOp>(builder.create(__state__));
  assert(__res__ && "builder didn't return the right type");
  return __res__;
}

FIntModuleOp FIntModuleOp::create(::mlir::ImplicitLocOpBuilder &builder, StringAttr name, ArrayRef<PortInfo> ports, StringRef intrinsicNameStr, ArrayAttr annotations, ArrayAttr parameters, ArrayAttr layers) {
