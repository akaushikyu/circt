  auto tblgen_amount = getProperties().amount; (void)tblgen_amount;
  if (!tblgen_amount) return emitError(loc, "'firrtl.pad' op requires attribute 'amount'");

  if (tblgen_amount && !(((::llvm::isa<::mlir::IntegerAttr>(tblgen_amount))) && ((::llvm::cast<::mlir::IntegerAttr>(tblgen_amount).getType().isSignlessInteger(32)))))
    return emitError(loc, "'firrtl.pad' op attribute 'amount' failed to satisfy constraint: 32-bit signless integer attribute");
  return ::mlir::success();
}

::llvm::LogicalResult PadPrimOp::setPropertiesFromAttr(Properties &prop, ::mlir::Attribute attr, ::llvm::function_ref<::mlir::InFlightDiagnostic()> emitError) {
  ::mlir::DictionaryAttr dict = ::llvm::dyn_cast<::mlir::DictionaryAttr>(attr);
  if (!dict) {
    emitError() << "expected DictionaryAttr to set properties";
    return ::mlir::failure();
  }

  {
    auto &propStorage = prop.amount;
       auto attr = dict.get("amount");
    if (attr) {
      auto convertedAttr = ::llvm::dyn_cast<std::remove_reference_t<decltype(propStorage)>>(attr);
      if (convertedAttr) {
        propStorage = convertedAttr;
      } else {
        emitError() << "Invalid attribute `amount` in property conversion: " << attr;
        return ::mlir::failure();
      }
    }
  }
  return ::mlir::success();
}

