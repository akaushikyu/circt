    auto valueGroup0 = getODSResults(0);

    for (auto v : valueGroup0) {
      if (::mlir::failed(__mlir_ods_local_type_constraint_FIRRTL13(*this, v.getType(), "result", index++)))
        return ::mlir::failure();
