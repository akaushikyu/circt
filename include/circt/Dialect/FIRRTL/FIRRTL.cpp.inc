::llvm::LogicalResult SubfieldOpAdaptor::verify(::mlir::Location loc) {
  auto tblgen_fieldIndex = getProperties().fieldIndex; (void)tblgen_fieldIndex;
  if (!tblgen_fieldIndex) return emitError(loc, "'firrtl.subfield' op requires attribute 'fieldIndex'");

  if (tblgen_fieldIndex && !(((::llvm::isa<::mlir::IntegerAttr>(tblgen_fieldIndex))) && ((::llvm::cast<::mlir::IntegerAttr>(tblgen_fieldIndex).getType().isSignlessInteger(32)))))
    return emitError(loc, "'firrtl.subfield' op attribute 'fieldIndex' failed to satisfy constraint: 32-bit signless integer attribute");
  return ::mlir::success();
}

::llvm::LogicalResult SubfieldOp::setPropertiesFromAttr(Properties &prop, ::mlir::Attribute attr, ::llvm::function_ref<::mlir::InFlightDiagnostic()> emitError) {
  ::mlir::DictionaryAttr dict = ::llvm::dyn_cast<::mlir::DictionaryAttr>(attr);
  if (!dict) {
    emitError() << "expected DictionaryAttr to set properties";
    return ::mlir::failure();
  }

  {
    auto &propStorage = prop.fieldIndex;
       auto attr = dict.get("fieldIndex");
    if (attr) {
      auto convertedAttr = ::llvm::dyn_cast<std::remove_reference_t<decltype(propStorage)>>(attr);
      if (convertedAttr) {
        propStorage = convertedAttr;
      } else {
        emitError() << "Invalid attribute `fieldIndex` in property conversion: " << attr;
        return ::mlir::failure();
      }
    }
  }
  return ::mlir::success();
}

::mlir::Attribute SubfieldOp::getPropertiesAsAttr(::mlir::MLIRContext *ctx, const Properties &prop) {
    ::mlir::SmallVector<::mlir::NamedAttribute> attrs;
    ::mlir::Builder odsBuilder{ctx};

    {
      const auto &propStorage = prop.fieldIndex;
      if (propStorage)
        attrs.push_back(odsBuilder.getNamedAttr("fieldIndex",
                                       propStorage));
    }

  if (!attrs.empty())
    return odsBuilder.getDictionaryAttr(attrs);
  return {};
}

