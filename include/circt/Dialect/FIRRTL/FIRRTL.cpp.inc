}

::mlir::Attribute RegResetOp::getPropertiesAsAttr(::mlir::MLIRContext *ctx, const Properties &prop) {
    ::mlir::SmallVector<::mlir::NamedAttribute> attrs;
    ::mlir::Builder odsBuilder{ctx};

    {
      const auto &propStorage = prop.annotations;
      if (propStorage)
        attrs.push_back(odsBuilder.getNamedAttr("annotations",
                                       propStorage));
    }

    {
      const auto &propStorage = prop.forceable;
      if (propStorage)
        attrs.push_back(odsBuilder.getNamedAttr("forceable",
                                       propStorage));
    }

    {
      const auto &propStorage = prop.inner_sym;
      if (propStorage)
        attrs.push_back(odsBuilder.getNamedAttr("inner_sym",
                                       propStorage));
    }

    {
      const auto &propStorage = prop.name;
      if (propStorage)
        attrs.push_back(odsBuilder.getNamedAttr("name",
                                       propStorage));
    }

    {
      const auto &propStorage = prop.nameKind;
      if (propStorage)
        attrs.push_back(odsBuilder.getNamedAttr("nameKind",
                                       propStorage));
    }

  if (!attrs.empty())
    return odsBuilder.getDictionaryAttr(attrs);
  return {};
}

llvm::hash_code RegResetOp::computePropertiesHash(const Properties &prop) {
  using llvm::hash_value;
  return llvm::hash_combine(
    llvm::hash_value(prop.annotations.getAsOpaquePointer()), 
    llvm::hash_value(prop.forceable.getAsOpaquePointer()), 
    llvm::hash_value(prop.inner_sym.getAsOpaquePointer()), 
    llvm::hash_value(prop.name.getAsOpaquePointer()), 
    llvm::hash_value(prop.nameKind.getAsOpaquePointer()));
}

std::optional<mlir::Attribute> RegResetOp::getInherentAttr(::mlir::MLIRContext *ctx, const Properties &prop, llvm::StringRef name) {
    if (name == "annotations")
      return prop.annotations;

    if (name == "forceable")
      return prop.forceable;

    if (name == "inner_sym")
      return prop.inner_sym;

    if (name == "name")
      return prop.name;

    if (name == "nameKind")
      return prop.nameKind;
  return std::nullopt;
}

void RegResetOp::setInherentAttr(Properties &prop, llvm::StringRef name, mlir::Attribute value) {
    if (name == "annotations") {
       prop.annotations = ::llvm::dyn_cast_or_null<std::remove_reference_t<decltype(prop.annotations)>>(value);
       return;
    }

    if (name == "forceable") {
       prop.forceable = ::llvm::dyn_cast_or_null<std::remove_reference_t<decltype(prop.forceable)>>(value);
       return;
    }

    if (name == "inner_sym") {
       prop.inner_sym = ::llvm::dyn_cast_or_null<std::remove_reference_t<decltype(prop.inner_sym)>>(value);
       return;
    }

    if (name == "name") {
       prop.name = ::llvm::dyn_cast_or_null<std::remove_reference_t<decltype(prop.name)>>(value);
       return;
    }

    if (name == "nameKind") {
       prop.nameKind = ::llvm::dyn_cast_or_null<std::remove_reference_t<decltype(prop.nameKind)>>(value);
       return;
