::llvm::LogicalResult GenericIntrinsicOpAdaptor::verify(::mlir::Location loc) {
  auto tblgen_intrinsic = getProperties().intrinsic; (void)tblgen_intrinsic;
  if (!tblgen_intrinsic) return emitError(loc, "'firrtl.int.generic' op requires attribute 'intrinsic'");
  auto tblgen_parameters = getProperties().parameters; (void)tblgen_parameters;

  if (tblgen_intrinsic && !((::llvm::isa<::mlir::StringAttr>(tblgen_intrinsic))))
    return emitError(loc, "'firrtl.int.generic' op attribute 'intrinsic' failed to satisfy constraint: string attribute");

  if (tblgen_parameters && !(((::llvm::isa<::mlir::ArrayAttr>(tblgen_parameters))) && (::llvm::all_of(::llvm::cast<::mlir::ArrayAttr>(tblgen_parameters), [&](::mlir::Attribute attr) { return attr && ((::llvm::isa<::circt::firrtl::ParamDeclAttr>(attr))); }))))
    return emitError(loc, "'firrtl.int.generic' op attribute 'parameters' failed to satisfy constraint: parameter array attribute");
  return ::mlir::success();
}

