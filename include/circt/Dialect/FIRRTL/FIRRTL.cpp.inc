FFlushOp FFlushOp::create(::mlir::OpBuilder &builder, ::mlir::Location location, Value clock, Value cond) {
  ::mlir::OperationState __state__(location, getOperationName());
  build(builder, __state__, std::forward<decltype(clock)>(clock), std::forward<decltype(cond)>(cond));
  auto __res__ = ::llvm::dyn_cast<FFlushOp>(builder.create(__state__));
  assert(__res__ && "builder didn't return the right type");
  return __res__;
}

