  auto tblgen_name = getProperties().name; (void)tblgen_name;
  if (!tblgen_name) return emitError(loc, "'firrtl.stop' op requires attribute 'name'");

  if (tblgen_exitCode && !(((::llvm::isa<::mlir::IntegerAttr>(tblgen_exitCode))) && ((::llvm::cast<::mlir::IntegerAttr>(tblgen_exitCode).getType().isSignlessInteger(32)))))
