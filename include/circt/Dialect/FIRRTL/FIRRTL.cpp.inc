    {
      const auto &propStorage = prop.fieldIndex;
      if (propStorage)
        attrs.push_back(odsBuilder.getNamedAttr("fieldIndex",
                                       propStorage));
    }

  if (!attrs.empty())
    return odsBuilder.getDictionaryAttr(attrs);
  return {};
}

