::llvm::LogicalResult VerbatimWireOpAdaptor::verify(::mlir::Location loc) {
  auto tblgen_symbols = getProperties().symbols; (void)tblgen_symbols;
  auto tblgen_text = getProperties().text; (void)tblgen_text;
  if (!tblgen_text) return emitError(loc, "'firrtl.verbatim.wire' op requires attribute 'text'");

  if (tblgen_text && !((::llvm::isa<::mlir::StringAttr>(tblgen_text))))
    return emitError(loc, "'firrtl.verbatim.wire' op attribute 'text' failed to satisfy constraint: string attribute");

  if (tblgen_symbols && !(((::llvm::isa<::mlir::ArrayAttr>(tblgen_symbols))) && (::llvm::all_of(::llvm::cast<::mlir::ArrayAttr>(tblgen_symbols), [&](::mlir::Attribute attr) { return attr && ((llvm::isa<::mlir::FlatSymbolRefAttr, ::circt::hw::InnerRefAttr>(attr))); }))))
    return emitError(loc, "'firrtl.verbatim.wire' op attribute 'symbols' failed to satisfy constraint: name reference array attribute");
  return ::mlir::success();
}

std::pair<unsigned, unsigned> VerbatimWireOp::getODSOperandIndexAndLength(unsigned index) {
  bool isVariadic[] = {true};
  int prevVariadicCount = 0;
  for (unsigned i = 0; i < index; ++i)
    if (isVariadic[i]) ++prevVariadicCount;

  // Calculate how many dynamic values a static variadic operand corresponds to.
  // This assumes all static variadic operands have the same dynamic value count.
  int variadicSize = (getOperation()->getNumOperands() - 0) / 1;
  // `index` passed in as the parameter is the static index which counts each
  // operand (variadic or not) as size 1. So here for each previous static variadic
  // operand, we need to offset by (variadicSize - 1) to get where the dynamic
  // value pack for this static operand starts.
  int start = index + (variadicSize - 1) * prevVariadicCount;
  int size = isVariadic[index] ? variadicSize : 1;
  return {start, size};
}

::mlir::MutableOperandRange VerbatimWireOp::getSubstitutionsMutable() {
  auto range = getODSOperandIndexAndLength(0);
  auto mutableRange = ::mlir::MutableOperandRange(getOperation(), range.first, range.second);
  return mutableRange;
}

::llvm::LogicalResult VerbatimWireOp::setPropertiesFromAttr(Properties &prop, ::mlir::Attribute attr, ::llvm::function_ref<::mlir::InFlightDiagnostic()> emitError) {
  ::mlir::DictionaryAttr dict = ::llvm::dyn_cast<::mlir::DictionaryAttr>(attr);
  if (!dict) {
    emitError() << "expected DictionaryAttr to set properties";
    return ::mlir::failure();
  }

  {
    auto &propStorage = prop.symbols;
       auto attr = dict.get("symbols");
    if (attr) {
      auto convertedAttr = ::llvm::dyn_cast<std::remove_reference_t<decltype(propStorage)>>(attr);
      if (convertedAttr) {
        propStorage = convertedAttr;
      } else {
        emitError() << "Invalid attribute `symbols` in property conversion: " << attr;
        return ::mlir::failure();
      }
    }
  }

  {
    auto &propStorage = prop.text;
       auto attr = dict.get("text");
    if (attr) {
      auto convertedAttr = ::llvm::dyn_cast<std::remove_reference_t<decltype(propStorage)>>(attr);
      if (convertedAttr) {
        propStorage = convertedAttr;
      } else {
        emitError() << "Invalid attribute `text` in property conversion: " << attr;
        return ::mlir::failure();
      }
    }
  }
  return ::mlir::success();
}

::mlir::Attribute VerbatimWireOp::getPropertiesAsAttr(::mlir::MLIRContext *ctx, const Properties &prop) {
    ::mlir::SmallVector<::mlir::NamedAttribute> attrs;
    ::mlir::Builder odsBuilder{ctx};

    {
      const auto &propStorage = prop.symbols;
      if (propStorage)
        attrs.push_back(odsBuilder.getNamedAttr("symbols",
                                       propStorage));
    }

    {
      const auto &propStorage = prop.text;
      if (propStorage)
        attrs.push_back(odsBuilder.getNamedAttr("text",
                                       propStorage));
    }

  if (!attrs.empty())
    return odsBuilder.getDictionaryAttr(attrs);
  return {};
}

llvm::hash_code VerbatimWireOp::computePropertiesHash(const Properties &prop) {
  using llvm::hash_value;
  return llvm::hash_combine(
    llvm::hash_value(prop.symbols.getAsOpaquePointer()), 
    llvm::hash_value(prop.text.getAsOpaquePointer()));
}

std::optional<mlir::Attribute> VerbatimWireOp::getInherentAttr(::mlir::MLIRContext *ctx, const Properties &prop, llvm::StringRef name) {
    if (name == "symbols")
      return prop.symbols;

    if (name == "text")
      return prop.text;
  return std::nullopt;
}

void VerbatimWireOp::setInherentAttr(Properties &prop, llvm::StringRef name, mlir::Attribute value) {
    if (name == "symbols") {
       prop.symbols = ::llvm::dyn_cast_or_null<std::remove_reference_t<decltype(prop.symbols)>>(value);
       return;
    }

    if (name == "text") {
       prop.text = ::llvm::dyn_cast_or_null<std::remove_reference_t<decltype(prop.text)>>(value);
       return;
    }
}

void VerbatimWireOp::populateInherentAttrs(::mlir::MLIRContext *ctx, const Properties &prop, ::mlir::NamedAttrList &attrs) {
    if (prop.symbols) attrs.append("symbols", prop.symbols);

    if (prop.text) attrs.append("text", prop.text);
}

::llvm::LogicalResult VerbatimWireOp::verifyInherentAttrs(::mlir::OperationName opName, ::mlir::NamedAttrList &attrs, llvm::function_ref<::mlir::InFlightDiagnostic()> emitError) {
    {
      ::mlir::Attribute attr = attrs.get(getSymbolsAttrName(opName));
      if (attr && ::mlir::failed(__mlir_ods_local_attr_constraint_FIRRTL39(attr, "symbols", emitError)))
        return ::mlir::failure();
    }

    {
      ::mlir::Attribute attr = attrs.get(getTextAttrName(opName));
      if (attr && ::mlir::failed(__mlir_ods_local_attr_constraint_FIRRTL2(attr, "text", emitError)))
        return ::mlir::failure();
    }
    return ::mlir::success();
}

::llvm::LogicalResult VerbatimWireOp::readProperties(::mlir::DialectBytecodeReader &reader, ::mlir::OperationState &state) {
  auto &prop = state.getOrAddProperties<Properties>(); (void)prop;
  if (::mlir::failed(reader.readOptionalAttribute(prop.symbols)))
    return ::mlir::failure();

  if (::mlir::failed(reader.readAttribute(prop.text)))
    return ::mlir::failure();
  return ::mlir::success();
}

void VerbatimWireOp::writeProperties(::mlir::DialectBytecodeWriter &writer) {
  auto &prop = getProperties(); (void)prop;

  writer.writeOptionalAttribute(prop.symbols);
  writer.writeAttribute(prop.text);
}

