}

void RegResetOp::populateInherentAttrs(::mlir::MLIRContext *ctx, const Properties &prop, ::mlir::NamedAttrList &attrs) {
    if (prop.annotations) attrs.append("annotations", prop.annotations);

    if (prop.forceable) attrs.append("forceable", prop.forceable);

    if (prop.inner_sym) attrs.append("inner_sym", prop.inner_sym);

    if (prop.name) attrs.append("name", prop.name);

