::mlir::ParseResult AttachOp::parse(::mlir::OpAsmParser &parser, ::mlir::OperationState &result) {
  ::llvm::SmallVector<::mlir::OpAsmParser::UnresolvedOperand, 4> attachedOperands;
  ::llvm::SMLoc attachedOperandsLoc;
  (void)attachedOperandsLoc;
  ::llvm::SmallVector<::mlir::Type, 1> attachedTypes;

  attachedOperandsLoc = parser.getCurrentLocation();
  if (parser.parseOperandList(attachedOperands))
    return ::mlir::failure();
  {
    auto loc = parser.getCurrentLocation();(void)loc;
    if (parser.parseOptionalAttrDict(result.attributes))
      return ::mlir::failure();
    if (failed(verifyInherentAttrs(result.name, result.attributes, [&]() {
        return parser.emitError(loc) << "'" << result.name.getStringRef() << "' op ";
      })))
      return ::mlir::failure();
  }
  if (parser.parseColon())
    return ::mlir::failure();

  if (parser.parseTypeList(attachedTypes))
    return ::mlir::failure();
  if (parser.resolveOperands(attachedOperands, attachedTypes, attachedOperandsLoc, result.operands))
    return ::mlir::failure();
  return ::mlir::success();
}

