::llvm::LogicalResult ViewIntrinsicOpAdaptor::verify(::mlir::Location loc) {
  auto tblgen_augmentedType = getProperties().augmentedType; (void)tblgen_augmentedType;
  if (!tblgen_augmentedType) return emitError(loc, "'firrtl.view' op requires attribute 'augmentedType'");
  auto tblgen_name = getProperties().name; (void)tblgen_name;
  if (!tblgen_name) return emitError(loc, "'firrtl.view' op requires attribute 'name'");
  auto tblgen_yamlFile = getProperties().yamlFile; (void)tblgen_yamlFile;

  if (tblgen_name && !((::llvm::isa<::mlir::StringAttr>(tblgen_name))))
    return emitError(loc, "'firrtl.view' op attribute 'name' failed to satisfy constraint: string attribute");

  if (tblgen_yamlFile && !((::llvm::isa<::mlir::StringAttr>(tblgen_yamlFile))))
    return emitError(loc, "'firrtl.view' op attribute 'yamlFile' failed to satisfy constraint: string attribute");

  if (tblgen_augmentedType && !((::llvm::isa<::circt::firrtl::AugmentedBundleTypeAttr>(tblgen_augmentedType))))
    return emitError(loc, "'firrtl.view' op attribute 'augmentedType' failed to satisfy constraint: GrandCentral AugmentedBundleType");
  return ::mlir::success();
}

std::pair<unsigned, unsigned> ViewIntrinsicOp::getODSOperandIndexAndLength(unsigned index) {
  bool isVariadic[] = {true};
  int prevVariadicCount = 0;
  for (unsigned i = 0; i < index; ++i)
    if (isVariadic[i]) ++prevVariadicCount;

  // Calculate how many dynamic values a static variadic operand corresponds to.
  // This assumes all static variadic operands have the same dynamic value count.
  int variadicSize = (getOperation()->getNumOperands() - 0) / 1;
  // `index` passed in as the parameter is the static index which counts each
  // operand (variadic or not) as size 1. So here for each previous static variadic
  // operand, we need to offset by (variadicSize - 1) to get where the dynamic
  // value pack for this static operand starts.
  int start = index + (variadicSize - 1) * prevVariadicCount;
  int size = isVariadic[index] ? variadicSize : 1;
  return {start, size};
}

