FModuleOp FModuleOp::create(::mlir::OpBuilder &builder, ::mlir::Location location, StringAttr name, ConventionAttr convention, ArrayRef<PortInfo> ports, ArrayAttr annotations, ArrayAttr layers) {
  ::mlir::OperationState __state__(location, getOperationName());
  build(builder, __state__, std::forward<decltype(name)>(name), std::forward<decltype(convention)>(convention), std::forward<decltype(ports)>(ports), std::forward<decltype(annotations)>(annotations), std::forward<decltype(layers)>(layers));
  auto __res__ = ::llvm::dyn_cast<FModuleOp>(builder.create(__state__));
  assert(__res__ && "builder didn't return the right type");
  return __res__;
}

FModuleOp FModuleOp::create(::mlir::ImplicitLocOpBuilder &builder, StringAttr name, ConventionAttr convention, ArrayRef<PortInfo> ports, ArrayAttr annotations, ArrayAttr layers) {
