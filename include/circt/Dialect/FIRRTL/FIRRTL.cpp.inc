::llvm::LogicalResult FModuleOp::verifyInherentAttrs(::mlir::OperationName opName, ::mlir::NamedAttrList &attrs, llvm::function_ref<::mlir::InFlightDiagnostic()> emitError) {
    {
      ::mlir::Attribute attr = attrs.get(getAnnotationsAttrName(opName));
      if (attr && ::mlir::failed(__mlir_ods_local_attr_constraint_FIRRTL7(attr, "annotations", emitError)))
        return ::mlir::failure();
    }

    {
