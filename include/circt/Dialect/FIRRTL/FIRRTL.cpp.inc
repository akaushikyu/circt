  if (tblgen_portTypes && !((::llvm::isa<::mlir::ArrayAttr>(tblgen_portTypes))))
    return emitError(loc, "'firrtl.class' op attribute 'portTypes' failed to satisfy constraint: array attribute");

  if (tblgen_portSymbols && !((::llvm::isa<::mlir::ArrayAttr>(tblgen_portSymbols))))
    return emitError(loc, "'firrtl.class' op attribute 'portSymbols' failed to satisfy constraint: array attribute");

  if (tblgen_portLocations && !((::llvm::isa<::mlir::ArrayAttr>(tblgen_portLocations))))
    return emitError(loc, "'firrtl.class' op attribute 'portLocations' failed to satisfy constraint: array attribute");

  if (tblgen_domainInfo && !((::llvm::isa<::mlir::ArrayAttr>(tblgen_domainInfo))))
    return emitError(loc, "'firrtl.class' op attribute 'domainInfo' failed to satisfy constraint: array attribute");
  return ::mlir::success();
}

