::mlir::ParseResult FFlushOp::parse(::mlir::OpAsmParser &parser, ::mlir::OperationState &result) {
  ::mlir::OpAsmParser::UnresolvedOperand clockRawOperand{};
  ::llvm::ArrayRef<::mlir::OpAsmParser::UnresolvedOperand> clockOperands(&clockRawOperand, 1);  ::llvm::SMLoc clockOperandsLoc;
  (void)clockOperandsLoc;
  ::mlir::OpAsmParser::UnresolvedOperand condRawOperand{};
  ::llvm::ArrayRef<::mlir::OpAsmParser::UnresolvedOperand> condOperands(&condRawOperand, 1);  ::llvm::SMLoc condOperandsLoc;
  (void)condOperandsLoc;
  ::mlir::StringAttr outputFileAttr;
  ::llvm::SmallVector<::mlir::OpAsmParser::UnresolvedOperand, 4> outputFileSubstitutionsOperands;
  ::llvm::SMLoc outputFileSubstitutionsOperandsLoc;
  (void)outputFileSubstitutionsOperandsLoc;
  ::mlir::Type clockRawType{};
  ::llvm::ArrayRef<::mlir::Type> clockTypes(&clockRawType, 1);
  ::mlir::Type condRawType{};
  ::llvm::ArrayRef<::mlir::Type> condTypes(&condRawType, 1);
  ::llvm::SmallVector<::mlir::Type, 1> outputFileSubstitutionsTypes;

  clockOperandsLoc = parser.getCurrentLocation();
  if (parser.parseOperand(clockRawOperand))
    return ::mlir::failure();
  if (parser.parseComma())
    return ::mlir::failure();

  condOperandsLoc = parser.getCurrentLocation();
  if (parser.parseOperand(condRawOperand))
    return ::mlir::failure();
  if (::mlir::succeeded(parser.parseOptionalComma())) {

  if (parser.parseCustomAttributeWithFallback(outputFileAttr, parser.getBuilder().getType<::mlir::NoneType>())) {
    return ::mlir::failure();
  }
  if (outputFileAttr) result.getOrAddProperties<FFlushOp::Properties>().outputFile = outputFileAttr;
  if (parser.parseLParen())
    return ::mlir::failure();

  outputFileSubstitutionsOperandsLoc = parser.getCurrentLocation();
  if (parser.parseOperandList(outputFileSubstitutionsOperands))
    return ::mlir::failure();
  if (parser.parseRParen())
    return ::mlir::failure();
  }
  {
    auto loc = parser.getCurrentLocation();(void)loc;
    if (parser.parseOptionalAttrDict(result.attributes))
      return ::mlir::failure();
    if (failed(verifyInherentAttrs(result.name, result.attributes, [&]() {
        return parser.emitError(loc) << "'" << result.name.getStringRef() << "' op ";
      })))
      return ::mlir::failure();
  }
  if (parser.parseColon())
    return ::mlir::failure();

  {
    ::circt::firrtl::BaseTypeAliasOr<::circt::firrtl::ClockType> type;
    if (parser.parseCustomTypeWithFallback(type))
      return ::mlir::failure();
    clockRawType = type;
  }
  if (parser.parseComma())
    return ::mlir::failure();

  {
    ::circt::firrtl::UIntType type;
    if (parser.parseCustomTypeWithFallback(type))
      return ::mlir::failure();
    condRawType = type;
  }
  if (::mlir::succeeded(parser.parseOptionalComma())) {

  if (parser.parseTypeList(outputFileSubstitutionsTypes))
    return ::mlir::failure();
  }
  if (parser.resolveOperands(clockOperands, clockTypes, clockOperandsLoc, result.operands))
    return ::mlir::failure();
  if (parser.resolveOperands(condOperands, condTypes, condOperandsLoc, result.operands))
    return ::mlir::failure();
  if (parser.resolveOperands(outputFileSubstitutionsOperands, outputFileSubstitutionsTypes, outputFileSubstitutionsOperandsLoc, result.operands))
    return ::mlir::failure();
  return ::mlir::success();
}

void FFlushOp::print(::mlir::OpAsmPrinter &_odsPrinter) {
  _odsPrinter << ' ';
  _odsPrinter << getClock();
  _odsPrinter << ",";
  _odsPrinter << ' ';
  _odsPrinter << getCond();
  if (!getOutputFileSubstitutions().empty()) {
    _odsPrinter << ",";
    _odsPrinter << ' ';
    _odsPrinter.printAttributeWithoutType(getOutputFileAttr());
    _odsPrinter << "(";
    _odsPrinter << getOutputFileSubstitutions();
    _odsPrinter << ")";
  }
  ::llvm::SmallVector<::llvm::StringRef, 2> elidedAttrs;
  elidedAttrs.push_back("outputFile");
  _odsPrinter.printOptionalAttrDict((*this)->getAttrs(), elidedAttrs);
  _odsPrinter << ' ' << ":";
  _odsPrinter << ' ';
  {
    auto type = getClock().getType();
    if (auto validType = ::llvm::dyn_cast<::circt::firrtl::BaseTypeAliasOr<::circt::firrtl::ClockType>>(type))
      _odsPrinter.printStrippedAttrOrType(validType);
   else
     _odsPrinter << type;
  }
  _odsPrinter << ",";
  _odsPrinter << ' ';
  {
    auto type = getCond().getType();
    if (auto validType = ::llvm::dyn_cast<::circt::firrtl::UIntType>(type))
      _odsPrinter.printStrippedAttrOrType(validType);
   else
     _odsPrinter << type;
  }
  if (!getOutputFileSubstitutions().empty()) {
    _odsPrinter << ",";
    _odsPrinter << ' ';
    _odsPrinter << getOutputFileSubstitutions().getTypes();
  }
}


