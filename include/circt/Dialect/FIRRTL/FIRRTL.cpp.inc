  auto tblgen_name = getProperties().name; (void)tblgen_name;
  if (!tblgen_name) return emitError(loc, "'firrtl.cover' op requires attribute 'name'");

  if (tblgen_message && !((::llvm::isa<::mlir::StringAttr>(tblgen_message))))
    return emitError(loc, "'firrtl.cover' op attribute 'message' failed to satisfy constraint: string attribute");

  if (tblgen_name && !((::llvm::isa<::mlir::StringAttr>(tblgen_name))))
    return emitError(loc, "'firrtl.cover' op attribute 'name' failed to satisfy constraint: string attribute");

  if (tblgen_isConcurrent && !((::llvm::isa<::mlir::BoolAttr>(tblgen_isConcurrent))))
