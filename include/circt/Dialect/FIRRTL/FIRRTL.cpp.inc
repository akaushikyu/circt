size_t FIntModuleOp::getNumPorts() {
  return getPortTypesAttr().size();
}

size_t FIntModuleOp::getNumInputPorts() {
  size_t count = 0;
  for (size_t i = 0, e = getNumPorts(); i < e; ++i)
    if (getPortDirection(i) == Direction::In)
      ++count;
  return count;
}

size_t FIntModuleOp::getNumOutputPorts() {
  size_t count = 0;
  for (size_t i = 0, e = getNumPorts(); i < e; ++i)
    if (getPortDirection(i) == Direction::Out)
      ++count;
  return count;
}

size_t FIntModuleOp::getPortIdForInputId(size_t idx) {
  for (size_t i = 0, e = getNumPorts(); i < e; ++i)
    if (getPortDirection(i) == Direction::In) {
      if (!idx)
        return i;
      --idx;
    }
  assert(0 && "Out of bounds input port id");
  return ~0ULL;
}

size_t FIntModuleOp::getPortIdForOutputId(size_t idx) {
  for (size_t i = 0, e = getNumPorts(); i < e; ++i)
    if (getPortDirection(i) == Direction::Out) {
      if (!idx)
        return i;
      --idx;
    }
  assert(0 && "Out of bounds input port id");
  return ~0ULL;
}

