  ::mlir::Type resultRawType{};
  ::llvm::ArrayRef<::mlir::Type> resultTypes(&resultRawType, 1);

  if (parser.parseCustomAttributeWithFallback(fieldsAttr, parser.getBuilder().getType<::mlir::NoneType>())) {
