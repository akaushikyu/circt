::llvm::LogicalResult CircuitOp::verifyInvariantsImpl() {
  auto tblgen_annotations = getProperties().annotations; (void)tblgen_annotations;
  auto tblgen_default_layer_specialization = getProperties().default_layer_specialization; (void)tblgen_default_layer_specialization;
  auto tblgen_disable_layers = getProperties().disable_layers; (void)tblgen_disable_layers;
  auto tblgen_enable_layers = getProperties().enable_layers; (void)tblgen_enable_layers;
  auto tblgen_name = getProperties().name; (void)tblgen_name;
  if (!tblgen_name) return emitOpError("requires attribute 'name'");
  auto tblgen_select_inst_choice = getProperties().select_inst_choice; (void)tblgen_select_inst_choice;

  if (::mlir::failed(__mlir_ods_local_attr_constraint_FIRRTL2(*this, tblgen_name, "name")))
    return ::mlir::failure();

  if (::mlir::failed(__mlir_ods_local_attr_constraint_FIRRTL7(*this, tblgen_annotations, "annotations")))
    return ::mlir::failure();

  if (::mlir::failed(__mlir_ods_local_attr_constraint_FIRRTL8(*this, tblgen_enable_layers, "enable_layers")))
    return ::mlir::failure();

  if (::mlir::failed(__mlir_ods_local_attr_constraint_FIRRTL8(*this, tblgen_disable_layers, "disable_layers")))
    return ::mlir::failure();

  if (::mlir::failed(__mlir_ods_local_attr_constraint_FIRRTL9(*this, tblgen_default_layer_specialization, "default_layer_specialization")))
    return ::mlir::failure();

  if (::mlir::failed(__mlir_ods_local_attr_constraint_FIRRTL1(*this, tblgen_select_inst_choice, "select_inst_choice")))
    return ::mlir::failure();
  {
    unsigned index = 0; (void)index;

    for (auto &region : ::llvm::MutableArrayRef((*this)->getRegion(0)))
      if (::mlir::failed(__mlir_ods_local_region_constraint_FIRRTL1(*this, region, "body", index++)))
        return ::mlir::failure();
  }
  return ::mlir::success();
}

::llvm::LogicalResult CircuitOp::verifyInvariants() {
  return verifyInvariantsImpl();
}

::mlir::ParseResult CircuitOp::parse(::mlir::OpAsmParser &parser, ::mlir::OperationState &result) {
  ::mlir::StringAttr nameAttr;
  std::unique_ptr<::mlir::Region> bodyRegion = std::make_unique<::mlir::Region>();

  if (parser.parseCustomAttributeWithFallback(nameAttr, parser.getBuilder().getType<::mlir::NoneType>())) {
    return ::mlir::failure();
  }
  if (nameAttr) result.getOrAddProperties<CircuitOp::Properties>().name = nameAttr;
  {
    auto odsResult = parseCircuitOpAttrs(parser, result.attributes);
    if (odsResult) return ::mlir::failure();
  }

  if (parser.parseRegion(*bodyRegion))
    return ::mlir::failure();

  if (bodyRegion->empty()) bodyRegion->emplaceBlock();
  result.addRegion(std::move(bodyRegion));
  return ::mlir::success();
}

void CircuitOp::print(::mlir::OpAsmPrinter &_odsPrinter) {
  _odsPrinter << ' ';
  _odsPrinter.printAttributeWithoutType(getNameAttr());
  printCircuitOpAttrs(_odsPrinter, *this, getOperation()->getAttrDictionary());
  _odsPrinter << ' ';
  _odsPrinter.printRegion(getBody());
}


