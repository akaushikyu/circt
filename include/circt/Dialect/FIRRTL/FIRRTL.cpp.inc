    ::mlir::SmallVector<::mlir::NamedAttribute> attrs;
    ::mlir::Builder odsBuilder{ctx};

    {
      const auto &propStorage = prop.amount;
      if (propStorage)
        attrs.push_back(odsBuilder.getNamedAttr("amount",
