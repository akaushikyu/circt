llvm::hash_code InstanceOp::computePropertiesHash(const Properties &prop) {
  using llvm::hash_value;
  return llvm::hash_combine(
    llvm::hash_value(prop.annotations.getAsOpaquePointer()), 
    llvm::hash_value(prop.doNotPrint.getAsOpaquePointer()), 
    llvm::hash_value(prop.domainInfo.getAsOpaquePointer()), 
    llvm::hash_value(prop.inner_sym.getAsOpaquePointer()), 
    llvm::hash_value(prop.layers.getAsOpaquePointer()), 
    llvm::hash_value(prop.lowerToBind.getAsOpaquePointer()), 
    llvm::hash_value(prop.moduleName.getAsOpaquePointer()), 
    llvm::hash_value(prop.name.getAsOpaquePointer()), 
    llvm::hash_value(prop.nameKind.getAsOpaquePointer()), 
    llvm::hash_value(prop.portAnnotations.getAsOpaquePointer()), 
    llvm::hash_value(prop.portDirections.getAsOpaquePointer()), 
    llvm::hash_value(prop.portNames.getAsOpaquePointer()));
}

