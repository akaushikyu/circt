::mlir::Attribute ClassOp::getPropertiesAsAttr(::mlir::MLIRContext *ctx, const Properties &prop) {
    ::mlir::SmallVector<::mlir::NamedAttribute> attrs;
    ::mlir::Builder odsBuilder{ctx};

    {
      const auto &propStorage = prop.domainInfo;
      if (propStorage)
        attrs.push_back(odsBuilder.getNamedAttr("domainInfo",
                                       propStorage));
    }

    {
      const auto &propStorage = prop.portDirections;
      if (propStorage)
        attrs.push_back(odsBuilder.getNamedAttr("portDirections",
                                       propStorage));
    }

    {
      const auto &propStorage = prop.portLocations;
      if (propStorage)
        attrs.push_back(odsBuilder.getNamedAttr("portLocations",
                                       propStorage));
    }

    {
      const auto &propStorage = prop.portNames;
      if (propStorage)
        attrs.push_back(odsBuilder.getNamedAttr("portNames",
                                       propStorage));
    }

    {
      const auto &propStorage = prop.portSymbols;
      if (propStorage)
        attrs.push_back(odsBuilder.getNamedAttr("portSymbols",
                                       propStorage));
    }

    {
      const auto &propStorage = prop.portTypes;
      if (propStorage)
        attrs.push_back(odsBuilder.getNamedAttr("portTypes",
                                       propStorage));
    }

    {
      const auto &propStorage = prop.sym_name;
      if (propStorage)
        attrs.push_back(odsBuilder.getNamedAttr("sym_name",
                                       propStorage));
    }

  if (!attrs.empty())
    return odsBuilder.getDictionaryAttr(attrs);
  return {};
}

llvm::hash_code ClassOp::computePropertiesHash(const Properties &prop) {
  using llvm::hash_value;
  return llvm::hash_combine(
    llvm::hash_value(prop.domainInfo.getAsOpaquePointer()), 
    llvm::hash_value(prop.portDirections.getAsOpaquePointer()), 
    llvm::hash_value(prop.portLocations.getAsOpaquePointer()), 
    llvm::hash_value(prop.portNames.getAsOpaquePointer()), 
    llvm::hash_value(prop.portSymbols.getAsOpaquePointer()), 
    llvm::hash_value(prop.portTypes.getAsOpaquePointer()), 
    llvm::hash_value(prop.sym_name.getAsOpaquePointer()));
}

std::optional<mlir::Attribute> ClassOp::getInherentAttr(::mlir::MLIRContext *ctx, const Properties &prop, llvm::StringRef name) {
    if (name == "domainInfo")
      return prop.domainInfo;

    if (name == "portDirections")
